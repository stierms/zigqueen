+        // every (attacker_key, to, attacked_rel) maps to a UNIQUE index in [0, 7680)
+        let mut seen = std::collections::HashSet::new();
+        for key in 0..NUM_ATTACKER_KEYS {
+            for to in 0..64 {
+                for ar in 0..NUM_ATTACKED_REL {
+                    let i = LeanThreatInputs::lean_index(key, to, ar);
+                    assert!(i < LEAN_NUM_FEATURES, "idx {i} >= {LEAN_NUM_FEATURES}");
+                    assert!(seen.insert(i), "collision at idx {i}");
+                }
+            }
+        }
+        assert_eq!(seen.len(), LEAN_NUM_FEATURES, "must cover all 7680 exactly");
+    }
+}
