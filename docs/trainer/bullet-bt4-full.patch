+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn temp(n: &str) -> std::path::PathBuf {
+        let p = std::env::temp_dir().join(format!("zq-bt4-state-{}-{n}", std::process::id()));
+        fs::create_dir(&p).unwrap();
+        p
+    }
+    #[test]
+    fn exposures_round_up_exactly() {
+        let s = Schedule::from_occurrences(100_000_000_000, 16384, 6104);
+        assert_eq!((s.main, s.tail), (3600, 900));
+        assert_eq!(Schedule::from_occurrences(1, 16384, 6104).main, 1);
+    }
+    #[test]
+    fn schedule_boundaries() {
+        let s = Schedule { main: 3600, tail: 900, batch: 16384, batches_per_sb: 6104 };
+        s.validate();
+        assert_eq!(s.lr(3600), s.lr(3601));
+        assert_eq!(s.lr(4500), 0.001 * 0.3f32.powi(5) * 0.1);
+        assert_eq!(s.average_samples_through(4500), (700..=900).step_by(25).map(|x| x + 3600).collect::<Vec<_>>());
+        for i in 2..=4500 {
+            assert!(s.lr(i) <= s.lr(i - 1))
+        }
+        assert!(!s.average_at(4275));
+    }
+    #[test]
+    fn final_once_and_short_tail() {
+        for tail in 1..=101 {
+            let s = Schedule { main: 2, tail, batch: 1, batches_per_sb: 1 };
+            let list = s.average_samples_through(s.total());
+            assert_eq!(list.last(), Some(&s.total()));
+            assert_eq!(list.iter().filter(|&&v| v == s.total()).count(), 1);
+        }
+    }
+    #[test]
+    fn average_resume_and_shape_guard() {
+        let p = temp("average");
+        let shape = BTreeMap::from([("w".into(), 2)]);
+        let mut avg = Average::default();
+        avg.add(25, &BTreeMap::from([("w".into(), vec![1., 3.])]));
+        avg.save(&p.join("a"));
+        let mut resumed = Average::load(&p.join("a"), &shape, &[25]);
+        resumed.add(50, &BTreeMap::from([("w".into(), vec![3., 7.])]));
+        assert_eq!(resumed.mean()["w"], vec![2., 5.]);
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                || resumed.add(50, &BTreeMap::from([("w".into(), vec![9., 9.])]))
+            ))
+            .is_err()
+        );
+        fs::remove_dir_all(p).unwrap();
+    }
+    #[test]
+    fn checkpoint_integrity_rejects_tamper_and_extra() {
+        let p = temp("seal");
+        let pending = p.join("sb1.pending");
+        fs::create_dir(&pending).unwrap();
+        write_metadata(&pending.join("state.tsv"), &BTreeMap::from([("sb".into(), "1".into())]));
+        fs::write(pending.join("weights"), b"123").unwrap();
+        let finalp = p.join("sb1");
+        seal_and_publish(&pending, &finalp);
+        verify_checkpoint(&finalp);
+        fs::write(finalp.join("extra"), b"x").unwrap();
+        assert!(std::panic::catch_unwind(|| verify_checkpoint(&finalp)).is_err());
+        fs::remove_file(finalp.join("extra")).unwrap();
+        fs::write(finalp.join("weights"), b"124").unwrap();
+        assert!(std::panic::catch_unwind(|| verify_checkpoint(&finalp)).is_err());
+        fs::remove_dir_all(p).unwrap();
+    }
+    #[test]
+    fn model_and_optimizer_strictness() {
+        let p = temp("model");
+        let vals = BTreeMap::from([("w".into(), vec![1., 2.])]);
+        for n in ["weights.bin", "momentum.bin", "velocity.bin"] {
+            write_tensors(&p.join(n), &vals);
+        }
+        validate_optimizer(&p, &shapes(&vals));
+        fs::write(p.join("momentum.bin"), b"w\n\x02\0\0\0\0\0\0\0").unwrap();
+        assert!(std::panic::catch_unwind(|| validate_optimizer(&p, &shapes(&vals))).is_err());
+        fs::remove_dir_all(p).unwrap();
+    }
+}
