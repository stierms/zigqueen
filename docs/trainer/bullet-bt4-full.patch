+                    let g = *getter;
+                    s.spawn(move || {
+                        for (v, pos) in val_chunk.iter_mut().zip(data_chunk) {
+                            *v = g(pos);
+                        }
+                    });
+                });
+            });
+            prep.extras.push((name.clone(), vals));
+        }
+
         prep
     }
 }
