+pub fn write_metadata(path: &Path, meta: &BTreeMap<String, String>) {
+    let mut f = OpenOptions::new().create_new(true).write(true).open(path).unwrap();
+    for (k, v) in meta {
+        assert!(!k.contains(['\t', '\n']) && !v.contains(['\t', '\n']));
+        writeln!(f, "{k}\t{v}").unwrap();
+    }
+    f.sync_all().unwrap();
+}
+pub fn read_metadata(path: &Path) -> BTreeMap<String, String> {
+    let mut out = BTreeMap::new();
+    for l in fs::read_to_string(path).unwrap().lines() {
+        let (k, v) = l.split_once('\t').unwrap();
+        assert!(out.insert(k.into(), v.into()).is_none());
+    }
+    out
+}
+fn files(dir: &Path, prefix: &str, out: &mut Vec<String>) {
+    for e in fs::read_dir(dir).unwrap() {
+        let e = e.unwrap();
+        assert!(!e.file_type().unwrap().is_symlink());
+        let name = e.file_name().into_string().unwrap();
+        assert!(!name.contains(['\n', '\t']));
+        let rel = format!("{prefix}{name}");
+        if e.file_type().unwrap().is_dir() {
+            files(&e.path(), &format!("{rel}/"), out)
+        } else if rel != "CHECKSUMS.tsv" {
+            assert!(e.file_type().unwrap().is_file());
+            out.push(rel)
+        }
+    }
+}
+/// Writer has finished every file before publication. A killed save leaves a
+/// .pending directory which is never a resumable checkpoint.
+pub fn seal_and_publish(pending: &Path, final_path: &Path) {
+    assert!(!final_path.exists());
+    let mut list = vec![];
+    files(pending, "", &mut list);
+    list.sort();
+    assert!(list.contains(&"state.tsv".into()));
+    let mut f = OpenOptions::new().create_new(true).write(true).open(pending.join("CHECKSUMS.tsv")).unwrap();
+    for rel in list {
+        let p = pending.join(&rel);
+        File::open(&p).unwrap().sync_all().unwrap();
+        writeln!(f, "{}\t{}\t{}", sha256(&p), fs::metadata(&p).unwrap().len(), rel).unwrap();
+    }
+    f.sync_all().unwrap();
+    File::open(pending).unwrap().sync_all().unwrap();
+    fs::rename(pending, final_path).unwrap();
+    File::open(final_path.parent().unwrap()).unwrap().sync_all().unwrap();
+}
+pub fn verify_checkpoint(dir: &Path) {
+    assert!(!dir.file_name().unwrap().to_string_lossy().contains("pending"));
+    let mut actual = vec![];
+    files(dir, "", &mut actual);
+    actual.sort();
+    let mut listed = vec![];
+    for l in fs::read_to_string(dir.join("CHECKSUMS.tsv")).unwrap().lines() {
+        let v: Vec<_> = l.split('\t').collect();
+        assert_eq!(v.len(), 3);
+        assert!(v[0].len() == 64 && v[0].bytes().all(|x| x.is_ascii_hexdigit()));
+        assert!(!v[2].starts_with('/') && !v[2].split('/').any(|x| x == ".."));
+        let p = dir.join(v[2]);
+        assert_eq!(fs::metadata(&p).unwrap().len(), v[1].parse::<u64>().unwrap());
+        assert_eq!(sha256(&p), v[0]);
+        listed.push(v[2].to_string());
+    }
+    listed.sort();
+    assert_eq!(actual, listed);
+    assert!(listed.contains(&"state.tsv".into()));
+}
