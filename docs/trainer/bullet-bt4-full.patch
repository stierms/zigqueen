+            ),
+        ];
+        for (fen, want_stm, want_ntm) in cases {
+            let board: ChessBoard = format!("{fen} | 0 | 0.5").parse().unwrap();
+            let mut stm = std::collections::BTreeSet::new();
+            let mut ntm = std::collections::BTreeSet::new();
+            inputs.map_features(&board, |s, n| {
