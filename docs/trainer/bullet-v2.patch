+                for (xo, yo) in [(false, false), (false, true), (true, false), (true, true)] {
+                    if let Some(i) = pp1_index(x, xo, y, yo) {
+                        assert!(i < PP1_INPUTS && pp1_is_live(i));
+                        assert!(hit.insert(i), "duplicate index {i}");
+                        assert_eq!(pp1_index(y, yo, x, xo), Some(i), "order dependence");
+                        count += 1;
+                    }
+                }
+            }
+        }
+        assert_eq!(count, PP1_LIVE);
+        assert_eq!(hit.len(), PP1_LIVE);
+    }
