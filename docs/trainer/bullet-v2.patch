+    #[test]
+    fn dictionary_arithmetic() {
+        assert_eq!((1..=5).map(|a| r15(a, a + 1)).collect::<Vec<_>>(), vec![0, 5, 9, 12, 14]);
+        assert_eq!(r15(5, 6), 14);
+        let live = (0..PP1_INPUTS).filter(|&i| pp1_is_live(i)).count();
+        assert_eq!(live, PP1_LIVE);
+        // Enumerate every oriented pair: indices unique per (pair, colours), all live rows hit.
+        let mut hit = BTreeSet::new();
+        let mut count = 0;
+        for x in 8..56 {
