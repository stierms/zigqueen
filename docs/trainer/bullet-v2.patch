+//! Experimental zigqueen dense-head arithmetic. CUDA forward boundaries are
+//! explicit; backward uses the conventional smooth affine derivative. The
+//! surrounding QAT STE and activation derivatives remain ordinary graph nodes.
+use bullet_compiler::tensor::{
+    DType, DValue, IRTrace, Size, TNode, TType,
+    operation::{
+        Matmul, MatrixLayout,
+        autograd::{Autograd, AutogradOnCoreOp, AutogradOp},
+    },
+};
+use bullet_gpu::{kernel::KernelSrc, runtime::Dim3};
+use std::{collections::BTreeSet, rc::Rc};
+
+#[derive(Debug, PartialEq)]
+pub(super) struct ScaledAdd {
+    pub ty: TType,
+    pub scale: f32,
+    pub rows: usize,
+}
+
+impl Autograd for ScaledAdd {
+    fn opname(&self) -> String {
+        "zq.deployed.scaled_add".into()
+    }
+    fn inputs(&self) -> Vec<TType> {
+        vec![self.ty, self.ty]
+    }
+    fn forward<'a>(&self, inputs: Vec<TNode<'a>>) -> Result<Vec<TNode<'a>>, IRTrace> {
+        let rows = self.rows;
+        let source = format!(
+            r#"
+extern "C" __global__ void zq_scaled_add(int batch, const float* x, const float* bias, float* y) {{
+    const unsigned long long i = (unsigned long long)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < (unsigned long long)batch * {rows})
+        y[i] = __fadd_rn(__fmul_rn(x[i], __uint_as_float({scale}u)), bias[i]);
+}}
+"#,
+            scale = self.scale.to_bits()
+        );
+        // Elementwise input/output extents are identical. All buffers are owned
+        // by the executor until synchronization; the bounds guard covers tails.
+        let kernel = unsafe {
+            KernelSrc::new(
+                self.inputs(),
+                vec![self.ty],
+                "zq_scaled_add".into(),
+                source,
+                true,
+                vec![(0, true), (1, true), (0, false)],
+                BTreeSet::new(),
+                Rc::new(move |batch| Dim3 { x: (batch * rows).div_ceil(256).try_into().unwrap(), y: 1, z: 1 }),
+                Rc::new(|_| 256),
+                Rc::new(|_| 0),
+            )
+        };
+        inputs[0].builder().add_op(inputs, kernel)
+    }
+    fn backward<'a>(&self, inputs: Vec<TNode<'a>>, grads: Vec<TNode<'a>>) -> Result<Vec<Option<TNode<'a>>>, IRTrace> {
+        assert_eq!(inputs.len(), 2);
+        assert_eq!(grads.len(), 1);
+        let g = grads[0];
+        let scale = g.builder().scalar(DValue::F32(self.scale), self.ty.size());
+        Ok(vec![Some((g * scale)?), Some(g)])
+    }
+    fn equals(&self, other: &Rc<dyn Autograd>) -> bool {
+        AutogradOp::downcast_rc(other).is_some_and(|other: &Self| self == other)
+    }
+}
+
+#[derive(Debug, PartialEq)]
+pub(super) struct OrderedAffine {
+    pub outputs: usize,
+    pub inputs: usize,
+    pub fixed16: bool,
+}
+
+impl Autograd for OrderedAffine {
+    fn opname(&self) -> String {
+        format!("zq.deployed.affine.{}.{}.{}", self.outputs, self.inputs, self.fixed16)
+    }
+    fn inputs(&self) -> Vec<TType> {
+        let m = self.outputs;
+        let n = self.inputs;
+        vec![
+            TType::new(m * n, DType::F32),
+            TType::new(Size::variable() * n, DType::F32),
+            TType::new(Size::variable() * m, DType::F32),
+        ]
+    }
+    fn forward<'a>(&self, inputs: Vec<TNode<'a>>) -> Result<Vec<TNode<'a>>, IRTrace> {
+        let m = self.outputs;
+        let n = self.inputs;
+        let arithmetic = if self.fixed16 {
+            assert_eq!(n, 32);
+            format!(
+                r#"
+    float lanes[16];
+    for(int k=0;k<16;++k) {{
+        const float first=__fadd_rn(0.0f,__fmul_rn(w[k*{m}+j],x[row*32+k]));
+        lanes[k]=__fadd_rn(first,__fmul_rn(w[(k+16)*{m}+j],x[row*32+k+16]));
+    }}
+    float sum=lanes[0];
+    for(int k=1;k<16;++k) sum=__fadd_rn(sum,lanes[k]);
+    y[i]=__fadd_rn(acc[i],sum);
+"#
+            )
+        } else {
+            format!(
+                r#"
+    float sum=acc[i];
+    for(int k=0;k<{n};++k) sum=__fadd_rn(sum,__fmul_rn(w[k*{m}+j],x[row*{n}+k]));
+    y[i]=sum;
+"#
+            )
+        };
+        let source = format!(
+            r#"
+extern "C" __global__ void zq_ordered_affine(int batch,const float* w,const float* x,const float* acc,float* y) {{
+    const unsigned long long i=(unsigned long long)blockIdx.x*blockDim.x+threadIdx.x;
+    if(i >= (unsigned long long)batch*{m}) return;
+    const int j=i%{m}; const unsigned long long row=i/{m};
+{arithmetic}
+}}
+"#
+        );
+        // W is column-major [m,n], X is [batch,n], and acc/Y are [batch,m].
+        // The executor validates tensor extents and keeps all buffers alive.
+        let kernel = unsafe {
+            KernelSrc::new(
+                self.inputs(),
+                vec![TType::new(Size::variable() * m, DType::F32)],
+                "zq_ordered_affine".into(),
+                source,
+                true,
+                vec![(0, true), (1, true), (2, true), (0, false)],
+                BTreeSet::new(),
+                Rc::new(move |batch| Dim3 { x: (batch * m).div_ceil(256).try_into().unwrap(), y: 1, z: 1 }),
+                Rc::new(|_| 256),
+                Rc::new(|_| 0),
+            )
+        };
+        inputs[0].builder().add_op(inputs, kernel)
+    }
+    fn backward<'a>(&self, inputs: Vec<TNode<'a>>, grads: Vec<TNode<'a>>) -> Result<Vec<Option<TNode<'a>>>, IRTrace> {
+        assert_eq!(inputs.len(), 3);
+        assert_eq!(grads.len(), 1);
+        let op = Matmul::new(
+            DType::F32,
+            1_usize,
+            MatrixLayout { rows: self.outputs.into(), cols: self.inputs.into(), col_mjr: true },
+            MatrixLayout { rows: self.inputs.into(), cols: Size::variable(), col_mjr: true },
+        )?;
+        let mut result = AutogradOnCoreOp::backward(&op, vec![inputs[0], inputs[1]], grads.clone())?;
+        // Initial accumulator may be a broadcast bias OR the preceding affine
+        // output. Its derivative is identity; the graph handles shared reduction.
+        result.push(Some(grads[0]));
+        Ok(result)
+    }
+    fn equals(&self, other: &Rc<dyn Autograd>) -> bool {
+        AutogradOp::downcast_rc(other).is_some_and(|other: &Self| self == other)
+    }
+}
