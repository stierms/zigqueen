+        let mut t = st::Tensors::new();
+        t.insert("l0w".into(), (0..FT * ROWS).map(|i| (i % 1000) as f32 * 1e-3).collect());
+        t.insert("l0b".into(), vec![0.5; FT]);
+        let s = split_l0w(t.clone());
+        assert_eq!(s["pawn"].len(), PAWN * FT);
+        assert_eq!(s["base"].len(), HALFKA * FT);
+        assert!(merge_l0w(s) == t);
+    }
+
+    #[test]
+    fn resume_rule() {
+        let mut a = BTreeMap::new();
+        for k in KEYS {
+            a.insert(k.to_string(), "x".to_string());
+        }
+        a.insert("main_sb".into(), "4721".into());
+        a.insert("finish_qat".into(), "off".into());
+        let mut b = a.clone();
+        assert!(!resume_config_ok(&a, &b, 100));
+        b.insert("finish_qat".into(), "on".into());
+        assert!(resume_config_ok(&a, &b, 4721));
+        assert!(std::panic::catch_unwind(|| resume_config_ok(&a, &b, 4700)).is_err());
+        let mut c = b.clone();
+        c.insert("threads".into(), "y".into());
+        assert!(std::panic::catch_unwind(|| resume_config_ok(&a, &c, 4721)).is_err());
+    }
+}
