+        format!("{fen} | 0 | 0.5").parse().unwrap()
+    }
+    fn feats(inp: &PawnPairInputsPP1, pos: &ChessBoard) -> (Vec<usize>, Vec<usize>) {
+        let (mut s, mut n) = (vec![], vec![]);
+        inp.map_features(pos, |a, b| {
+            s.push(a);
+            n.push(b);
+        });
+        (s, n)
+    }
+    struct Rng(u64);
+    impl Rng {
+        fn next(&mut self) -> u64 {
+            self.0 = self.0.wrapping_add(GAMMA);
+            fin(self.0)
+        }
+    }
+    /// Random legal-ish pawn placement with kings (not necessarily legal chess).
+    fn random_board(rng: &mut Rng) -> String {
+        let mut cells = [' '; 64];
+        let k1 = (rng.next() % 64) as usize;
+        let mut k2 = (rng.next() % 64) as usize;
+        while k2 == k1 {
+            k2 = (rng.next() % 64) as usize;
+        }
+        cells[k1] = 'K';
+        cells[k2] = 'k';
+        for (ch, count) in [('P', rng.next() % 9), ('p', rng.next() % 9), ('N', rng.next() % 3), ('r', rng.next() % 3)] {
+            let mut placed = 0;
+            while placed < count {
+                let sq = (rng.next() % 64) as usize;
+                let r = sq / 8;
+                if cells[sq] != ' ' || ((ch == 'P' || ch == 'p') && (r == 0 || r == 7)) {
+                    continue;
+                }
+                cells[sq] = ch;
+                placed += 1;
+            }
+        }
+        let mut fen = String::new();
+        for rank in (0..8).rev() {
+            let mut empty = 0;
+            for file in 0..8 {
+                let c = cells[rank * 8 + file];
+                if c == ' ' {
+                    empty += 1;
+                } else {
+                    if empty > 0 {
+                        fen.push_str(&empty.to_string());
+                        empty = 0;
+                    }
+                    fen.push(c);
+                }
+            }
+            if empty > 0 {
+                fen.push_str(&empty.to_string());
+            }
+            if rank > 0 {
+                fen.push('/');
+            }
+        }
+        fen.push_str(if rng.next() % 2 == 0 { " w - - 0 1" } else { " b - - 0 1" });
+        fen
