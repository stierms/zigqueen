+            let us: BTreeSet<_> = s.iter().collect();
+            let un: BTreeSet<_> = n.iter().collect();
+            assert_eq!(us.len(), s.len(), "duplicate stm index");
+            assert_eq!(un.len(), n.len(), "duplicate ntm index");
+            assert!(s.iter().chain(&n).all(|&i| pp1_is_live(i)));
+            // Colour-flipped board (same stm role for the other colour): stm/ntm swap roles
+            // only through the colour swap, so the stm set of the flip equals ... the stm set.
+            let flipped = board(&colour_flip(&fen));
+            let (fs, fnn) = feats(&inp, &flipped);
+            let a: BTreeSet<_> = fs.into_iter().collect();
+            let b: BTreeSet<_> = fnn.into_iter().collect();
+            assert_eq!(a, s.iter().copied().collect(), "colour flip changed stm features");
+            assert_eq!(b, n.iter().copied().collect(), "colour flip changed ntm features");
+        }
+        assert!(max_seen > 20);
+        let full = board("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1");
+        let (s, _) = feats(&inp, &full);
+        // 16 pawns, two rows: same-file own/opp 8, adjacent same colour same rank 7+7,
+        // adjacent across (distance 5) 14.
+        assert_eq!(s.len(), 8 + 14 + 14);
+        let (s, n) = feats(&PawnPairInputsPP1::absent(), &full);
+        assert!(s.is_empty() && n.is_empty());
+        assert_eq!(PawnPairInputsPP1::absent().num_inputs(), 0);
+    }
+
+    #[test]
+    fn scramble_preserves_counts_and_is_deterministic() {
+        let mut rng = Rng(11);
+        let mut changed = 0;
+        for _ in 0..5000 {
+            let pos = board(&random_board(&mut rng));
+            let (own, opp) = pawn_sets(&pos);
+            let (so, sp) = scrambled_pawn_sets(&pos);
+            assert_eq!(so & sp, 0);
+            for r in 0..8 {
+                let m = 0xFFu64 << (8 * r);
+                assert_eq!((own & m).count_ones(), (so & m).count_ones());
+                assert_eq!((opp & m).count_ones(), (sp & m).count_ones());
+            }
+            assert_eq!(scrambled_pawn_sets(&pos), (so, sp));
+            let perms = scramble_perms(&pos);
+            for p in perms {
+                let mut seen = [false; 8];
+                for f in p {
+                    seen[f as usize] = true;
+                }
+                assert!(seen.iter().all(|&x| x));
+            }
+            assert_eq!(perms[0], [0, 1, 2, 3, 4, 5, 6, 7]);
+            assert_eq!(perms[7], [0, 1, 2, 3, 4, 5, 6, 7]);
+            if (so, sp) != (own, opp) {
+                changed += 1;
+            }
+            let (s, n) = feats(&PawnPairInputsPP1::scrambled(), &pos);
+            assert_eq!(s.len(), n.len());
+        }
+        assert!(changed > 4000);
+    }
+}
