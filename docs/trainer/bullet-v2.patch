@@ -0,0 +1,459 @@
+//! zigqueen B3 pawn-pair inputs, dictionary PP1 (docs/research/B3_PAWN_PAIRS_DESIGN_2026-09-30.md,
+//! frozen at zigqueen commit dba3741af). Own code; no other engine's layout was consulted.
+//!
+//! Frame (per perspective, identical to HalfKA and the full-threat block): the board is
+//! stm-normalised; the stm perspective uses square `s ^ stm_flip`, the ntm perspective
+//! `s ^ 56 ^ ntm_flip`, flip = 7 iff that side's king file > 3. Colours are
+//! perspective-relative (own / opp). Only pawns on board ranks 2..7 take part.
+//!
+//! Every unordered pair of pawns whose files differ by at most one:
+//!   S (same file):     idx = c*120 + file*15 + R15(r_lo, r_hi),  c = 2*[lo opp] + [hi opp]
+//!   A (adjacent file): idx = 480 + c*252 + file_left*36 + 6*(r_left-1) + (r_right-1),
+//!                      c = 2*[left opp] + [right opp]
+//!   Exclusion: in A with |r_left - r_right| == 1 the pair is emitted only if the lower pawn
+//!   is opp and the upper pawn is own (the other colourings are P->P threat features).
+//! 1,488 rows, 1,278 live, at most 120 active per perspective.
+//!
+//! `PawnPairInputsPP1::scrambled()` is the arm-C control of the B3 pilot: per position,
+//! the pawns of both colours on each rank are moved by one pseudo-random file permutation
+//! per rank (seeded from the position), then the same dictionary is applied. Per-rank,
+//! per-colour counts are preserved; file relations are destroyed.
+use bulletformat::ChessBoard;
+
+use super::SparseInputType;
+
+pub const PP1_INPUTS: usize = 1488;
+pub const PP1_LIVE: usize = 1278;
+pub const PP1_MAX_ACTIVE: usize = 120;
+pub const PP1_S_ROWS: usize = 480;
+/// Layout code written into ZQBA headers (1 = PR1, never implemented).
+pub const PP1_LAYOUT: u32 = 2;
+const RANKS_2_TO_7: u64 = 0x00FF_FFFF_FFFF_FF00;
+const GAMMA: u64 = 0x9e37_79b9_7f4a_7c15;
+const SCRAMBLE_SALT: u64 = 0x4233_5050_5343_5231;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PawnPairMode {
+    /// No pawn block (zero inputs): the unchanged-feature arm.
+    Absent,
+    Real,
+    Scrambled,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct PawnPairInputsPP1 {
+    mode: PawnPairMode,
+}
+
+impl PawnPairInputsPP1 {
+    pub fn real() -> Self {
+        Self { mode: PawnPairMode::Real }
+    }
+    pub fn scrambled() -> Self {
+        Self { mode: PawnPairMode::Scrambled }
+    }
+    pub fn absent() -> Self {
+        Self { mode: PawnPairMode::Absent }
+    }
+    pub fn from_arm(arm: &str) -> Self {
+        match arm {
+            "real" => Self::real(),
+            "scrambled" => Self::scrambled(),
+            "none" => Self::absent(),
+            _ => panic!("unknown pawn-pair arm {arm}"),
+        }
+    }
+    pub fn mode(&self) -> PawnPairMode {
+        self.mode
+    }
+}
+
+/// R15 for 1 <= a < b <= 6.
+#[inline]
+pub fn r15(a: usize, b: usize) -> usize {
+    debug_assert!(1 <= a && a < b && b <= 6);
+    let (a1, b1) = (a - 1, b - 1);
+    a1 * (11 - a1) / 2 + (b1 - a1 - 1)
+}
+
+/// PP1 index of the pair {x, y} of ORIENTED squares with perspective-relative colours
+/// (`*_opp` true = the perspective's opponent). None when the pair is not in the
+/// dictionary (files two or more apart, or a threat-duplicate colouring).
+#[inline]
+pub fn pp1_index(x: usize, x_opp: bool, y: usize, y_opp: bool) -> Option<usize> {
+    let (fx, fy, rx, ry) = (x & 7, y & 7, x >> 3, y >> 3);
+    assert!((1..=6).contains(&rx) && (1..=6).contains(&ry) && x != y, "pawn outside ranks 2..7");
+    if fx == fy {
+        let (lo, lo_opp, hi, hi_opp) = if rx < ry { (rx, x_opp, ry, y_opp) } else { (ry, y_opp, rx, x_opp) };
+        let c = 2 * usize::from(lo_opp) + usize::from(hi_opp);
+        return Some(c * 120 + fx * 15 + r15(lo, hi));
+    }
+    if fx.abs_diff(fy) != 1 {
+        return None;
+    }
+    let (lf, lr, l_opp, rr, r_opp) = if fx < fy { (fx, rx, x_opp, ry, y_opp) } else { (fy, ry, y_opp, rx, x_opp) };
+    if lr.abs_diff(rr) == 1 {
+        let (lower_opp, upper_opp) = if lr < rr { (l_opp, r_opp) } else { (r_opp, l_opp) };
+        if !(lower_opp && !upper_opp) {
+            return None;
+        }
+    }
+    let c = 2 * usize::from(l_opp) + usize::from(r_opp);
+    Some(PP1_S_ROWS + c * 252 + lf * 36 + 6 * (lr - 1) + (rr - 1))
+}
+
+/// True iff `idx` can ever be emitted (the 210 threat-duplicate rows cannot).
+pub fn pp1_is_live(idx: usize) -> bool {
+    assert!(idx < PP1_INPUTS);
+    if idx < PP1_S_ROWS {
+        return true;
+    }
+    let a = idx - PP1_S_ROWS;
+    let c = a / 252;
+    let within = a % 252;
+    let (lr, rr) = (within % 36 / 6 + 1, within % 6 + 1);
+    let (l_opp, r_opp) = (c & 2 != 0, c & 1 != 0);
+    if lr.abs_diff(rr) != 1 {
+        return true;
+    }
+    let (lower_opp, upper_opp) = if lr < rr { (l_opp, r_opp) } else { (r_opp, l_opp) };
+    lower_opp && !upper_opp
+}
+
+#[inline]
+fn fin(mut z: u64) -> u64 {
+    z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    z ^ (z >> 31)
+}
+#[inline]
+fn mix(z: u64) -> u64 {
+    fin(z.wrapping_add(GAMMA))
+}
+
+/// Per-rank file permutations of the arm-C scramble for this position (board ranks 1..=6,
+/// 0-based; ranks 0 and 7 are identity and unused).
+pub fn scramble_perms(pos: &ChessBoard) -> [[u8; 8]; 8] {
+    let mut h = mix(SCRAMBLE_SALT ^ pos.occ);
+    h = mix(h ^ u64::from_le_bytes(pos.pcs[0..8].try_into().unwrap()));
+    h = mix(h ^ u64::from_le_bytes(pos.pcs[8..16].try_into().unwrap()));
+    let mut perms = [[0u8, 1, 2, 3, 4, 5, 6, 7]; 8];
+    for (r, perm) in perms.iter_mut().enumerate().take(7).skip(1) {
+        let mut state = h ^ (r as u64).wrapping_mul(GAMMA);
+        for j in (1..8usize).rev() {
+            state = state.wrapping_add(GAMMA);
+            let k = (fin(state) % (j as u64 + 1)) as usize;
+            perm.swap(j, k);
+        }
+    }
+    perms
+}
+
+/// (stm pawn bitboard, ntm pawn bitboard) on the stm-normalised board, ranks 2..7 only.
+pub fn pawn_sets(pos: &ChessBoard) -> (u64, u64) {
+    let (mut own, mut opp) = (0u64, 0u64);
+    for (piece, square) in (*pos).into_iter() {
+        match piece {
+            0 => own |= 1u64 << square,
+            8 => opp |= 1u64 << square,
+            _ => {}
+        }
+    }
+    (own & RANKS_2_TO_7, opp & RANKS_2_TO_7)
+}
+
+pub fn scrambled_pawn_sets(pos: &ChessBoard) -> (u64, u64) {
+    let (own, opp) = pawn_sets(pos);
+    let perms = scramble_perms(pos);
+    let apply = |bb: u64| {
+        let mut out = 0u64;
+        let mut b = bb;
+        while b != 0 {
+            let sq = b.trailing_zeros() as usize;
+            b &= b - 1;
+            let (r, f) = (sq >> 3, sq & 7);
+            out |= 1u64 << (r * 8 + usize::from(perms[r][f]));
+        }
+        out
+    };
+    (apply(own), apply(opp))
+}
+
+/// Emit f(stm_idx, ntm_idx) for every live pair of the given stm-board pawn sets.
+pub fn map_pairs<F: FnMut(usize, usize)>(own: u64, opp: u64, our_ksq: u8, opp_ksq: u8, mut f: F) {
+    assert_eq!(own & opp, 0);
+    let stm_flip = if our_ksq % 8 > 3 { 7 } else { 0 };
+    let ntm_flip = if opp_ksq % 8 > 3 { 7 } else { 0 };
+    let mut sq = [0usize; 16];
+    let mut is_opp = [false; 16];
+    let mut n = 0;
+    for (bb, colour) in [(own, false), (opp, true)] {
+        let mut b = bb;
+        while b != 0 {
+            assert!(n < 16, "more than 16 pawns");
+            sq[n] = b.trailing_zeros() as usize;
+            is_opp[n] = colour;
+            b &= b - 1;
+            n += 1;
+        }
+    }
+    for i in 0..n {
+        for j in i + 1..n {
+            if (sq[i] & 7).abs_diff(sq[j] & 7) > 1 {
+                continue;
+            }
+            let s = pp1_index(sq[i] ^ stm_flip, is_opp[i], sq[j] ^ stm_flip, is_opp[j]);
+            // ntm perspective: vertical flip, colours swap.
+            let t = pp1_index(sq[i] ^ 56 ^ ntm_flip, !is_opp[i], sq[j] ^ 56 ^ ntm_flip, !is_opp[j]);
+            match (s, t) {
+                (Some(s), Some(t)) => f(s, t),
+                (None, None) => {}
+                _ => panic!("PP1 pair live in one perspective only"),
+            }
+        }
+    }
+}
+
+impl SparseInputType for PawnPairInputsPP1 {
+    type RequiredDataType = ChessBoard;
+
+    fn num_inputs(&self) -> usize {
+        if self.mode == PawnPairMode::Absent { 0 } else { PP1_INPUTS }
+    }
+
+    fn max_active(&self) -> usize {
+        if self.mode == PawnPairMode::Absent { 0 } else { PP1_MAX_ACTIVE }
+    }
+
+    fn map_features<F: FnMut(usize, usize)>(&self, pos: &Self::RequiredDataType, f: F) {
+        let (own, opp) = match self.mode {
+            PawnPairMode::Absent => return,
+            PawnPairMode::Real => pawn_sets(pos),
+            PawnPairMode::Scrambled => scrambled_pawn_sets(pos),
+        };
+        map_pairs(own, opp, pos.our_ksq(), pos.opp_ksq(), f);
+    }
+
+    fn shorthand(&self) -> String {
+        match self.mode {
+            PawnPairMode::Absent => "pp1none".to_string(),
+            PawnPairMode::Real => "pp1".to_string(),
+            PawnPairMode::Scrambled => "pp1scrambled".to_string(),
+        }
+    }
+
+    fn description(&self) -> String {
+        format!("zigqueen B3 pawn pairs PP1 (1,488 rows), mode {:?}", self.mode)
+    }
+}
+
+#[cfg(test)]
+mod tests {
