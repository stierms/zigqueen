index 0000000000000000000000000000000000000000..0838231b93cebac0a3a6211ebec08de7baf8262b
--- /dev/null
+++ b/examples/zq_bt4_state.rs
@@ -0,0 +1,362 @@
+//! Original BT4 recipe support: explicit schedule, strict checkpoint identity and
+//! equal-weight pre-folding averaging. CPU-only tests use rustc --test directly.
+use std::{
+    collections::BTreeMap,
+    fs::{self, File, OpenOptions},
+    io::Write,
+    path::Path,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Schedule {
+    pub main: usize,
+    pub tail: usize,
+    pub batch: usize,
+    pub batches_per_sb: usize,
+}
+impl Schedule {
+    pub fn from_occurrences(n: u64, batch: usize, batches_per_sb: usize) -> Self {
+        assert!(n > 0);
+        let denom = 10u128 * (batch as u128) * (batches_per_sb as u128);
+        Self {
+            main: usize::try_from((36u128 * (n as u128)).div_ceil(denom)).unwrap(),
+            tail: usize::try_from((9u128 * (n as u128)).div_ceil(denom)).unwrap(),
+            batch,
+            batches_per_sb,
+        }
+    }
+    pub fn validate(self) {
+        assert!(self.main > 0 && self.tail > 0 && self.batch > 0 && self.batches_per_sb > 0);
+        self.total().checked_mul(self.batches_per_sb).unwrap().checked_mul(self.batch).unwrap();
+    }
+    pub fn total(self) -> usize {
+        self.main.checked_add(self.tail).unwrap()
+    }
+    pub fn lr(self, sb: usize) -> f32 {
+        assert!(sb > 0 && sb <= self.total());
+        let floor = 0.001 * 0.3f32.powi(5);
+        if sb <= self.main {
+            if sb == self.main {
+                return floor;
+            }
+            let p = sb as f32 / self.main as f32;
+            0.001 + (floor - 0.001) * (1.0 - 0.5 * (1.0 + (std::f32::consts::PI * p).cos()))
+        } else {
+            let local = sb - self.main;
+            if local == self.tail {
+                return floor * 0.1;
+            }
+            let p = (local - 1) as f32 / (self.tail - 1) as f32;
+            floor + (floor * 0.1 - floor) * (1.0 - 0.5 * (1.0 + (std::f32::consts::PI * p).cos()))
+        }
+    }
+    pub fn checkpoint(self, sb: usize) -> bool {
+        sb == 1
+            || sb == self.main
+            || sb == self.total()
+            || (sb <= self.main && sb % 25 == 0)
+            || (sb > self.main && (sb - self.main) % 25 == 0)
+    }
+    pub fn average_at(self, sb: usize) -> bool {
+        if sb <= self.main || sb > self.total() {
+            return false;
+        }
+        let local = sb - self.main;
+        local as u128 * 4 > self.tail as u128 * 3 && (local % 25 == 0 || local == self.tail)
+    }
+    pub fn average_samples_through(self, sb: usize) -> Vec<usize> {
+        (1..=sb).filter(|&x| self.average_at(x)).collect()
+    }
+}
+
+pub fn sha256(path: &Path) -> String {
+    let out = std::process::Command::new("sha256sum").arg(path).output().unwrap();
+    assert!(out.status.success(), "Failed SHA256 {path:?}");
+    String::from_utf8(out.stdout).unwrap().split_whitespace().next().unwrap().into()
+}
+pub type Tensors = BTreeMap<String, Vec<f32>>;
+/// Strictly parse the captured Bullet x86-64 named-f32 format; reject truncation,
+/// duplicate IDs, excessive lengths and nonfinite values before handing to GPU.
+pub fn read_tensors(path: &Path) -> Tensors {
+    let bytes = fs::read(path).unwrap();
+    let mut p = 0;
+    let mut out = BTreeMap::new();
+    while p < bytes.len() {
+        let end = bytes[p..].iter().position(|&x| x == b'\n').expect("Unterminated tensor name") + p;
+        assert!(end > p && end - p < 128);
+        let id = std::str::from_utf8(&bytes[p..end]).unwrap().to_string();
+        assert!(id.bytes().all(|x| x.is_ascii_alphanumeric() || x == b'_'));
+        p = end + 1;
+        assert!(p + 8 <= bytes.len());
+        let n = u64::from_le_bytes(bytes[p..p + 8].try_into().unwrap());
+        p += 8;
+        let len = usize::try_from(n).unwrap().checked_mul(4).unwrap();
+        assert!(len > 0 && len <= bytes.len() - p);
+        let values: Vec<f32> =
+            bytes[p..p + len].chunks_exact(4).map(|x| f32::from_le_bytes(x.try_into().unwrap())).collect();
+        assert!(values.iter().all(|x| x.is_finite()), "Nonfinite tensor {id}");
+        p += len;
+        assert!(out.insert(id, values).is_none(), "Duplicate tensor ID");
+    }
+    assert!(!out.is_empty());
+    out
+}
+pub fn write_tensors(path: &Path, values: &Tensors) {
+    let mut f = OpenOptions::new().write(true).create_new(true).open(path).unwrap();
+    for (id, v) in values {
+        assert!(!v.is_empty() && v.iter().all(|x| x.is_finite()));
+        writeln!(f, "{id}").unwrap();
+        f.write_all(&(v.len() as u64).to_le_bytes()).unwrap();
+        for chunk in v.chunks(16384) {
+            let b: Vec<u8> = chunk.iter().flat_map(|x| x.to_le_bytes()).collect();
+            f.write_all(&b).unwrap();
+        }
+    }
+    f.sync_all().unwrap();
+}
+pub fn shapes(values: &Tensors) -> BTreeMap<String, usize> {
+    values.iter().map(|(k, v)| (k.clone(), v.len())).collect()
+}
+pub fn validate_optimizer(dir: &Path, expected: &BTreeMap<String, usize>) {
+    for name in ["weights.bin", "momentum.bin", "velocity.bin"] {
+        let tensors = read_tensors(&dir.join(name));
+        assert_eq!(&shapes(&tensors), expected, "Missing/extra/wrong-size optimizer tensor in {name}");
+        if name == "velocity.bin" {
+            assert!(tensors.values().flatten().all(|&v| v >= 0.0), "Negative Adam velocity");
+        }
+    }
+}
+
+#[derive(Default)]
+pub struct Average {
+    pub samples: Vec<usize>,
+    sums: BTreeMap<String, Vec<f64>>,
+}
+impl Average {
+    pub fn add(&mut self, sb: usize, values: &Tensors) {
+        assert!(self.samples.last().is_none_or(|&old| sb > old), "Duplicate/out-of-order averaging endpoint");
+        if self.sums.is_empty() {
+            self.sums = values.iter().map(|(k, v)| (k.clone(), vec![0.0; v.len()])).collect();
+        }
+        assert_eq!(self.sums.keys().collect::<Vec<_>>(), values.keys().collect::<Vec<_>>());
+        for (id, src) in values {
+            let dst = self.sums.get_mut(id).unwrap();
+            assert_eq!(dst.len(), src.len());
+            for (a, &b) in dst.iter_mut().zip(src) {
+                assert!(b.is_finite());
+                *a += f64::from(b);
+                assert!(a.is_finite());
+            }
+        }
+        self.samples.push(sb);
+    }
+    pub fn mean(&self) -> Tensors {
+        assert!(!self.samples.is_empty());
+        self.sums
+            .iter()
+            .map(|(k, v)| (k.clone(), v.iter().map(|&x| (x / self.samples.len() as f64) as f32).collect()))
+            .collect()
+    }
+    pub fn save(&self, path: &Path) {
+        let mut f = OpenOptions::new().create_new(true).write(true).open(path).unwrap();
+        f.write_all(b"ZQAVG1\n").unwrap();
+        writeln!(f, "{}", self.samples.iter().map(usize::to_string).collect::<Vec<_>>().join(",")).unwrap();
+        for (id, v) in &self.sums {
+            writeln!(f, "{id}").unwrap();
+            f.write_all(&(v.len() as u64).to_le_bytes()).unwrap();
+            for chunk in v.chunks(16384) {
+                let b: Vec<u8> = chunk.iter().flat_map(|x| x.to_le_bytes()).collect();
+                f.write_all(&b).unwrap();
+            }
+        }
+        f.sync_all().unwrap();
+    }
+    pub fn load(path: &Path, expected: &BTreeMap<String, usize>, samples: &[usize]) -> Self {
+        let b = fs::read(path).unwrap();
+        assert!(b.starts_with(b"ZQAVG1\n"));
+        let end = b[7..].iter().position(|&x| x == b'\n').unwrap() + 7;
+        let text = std::str::from_utf8(&b[7..end]).unwrap();
+        let loaded: Vec<usize> =
+            if text.is_empty() { vec![] } else { text.split(',').map(|x| x.parse().unwrap()).collect() };
+        assert_eq!(loaded, samples);
+        let mut p = end + 1;
+        let mut sums = BTreeMap::new();
+        while p < b.len() {
+            let end = b[p..].iter().position(|&x| x == b'\n').unwrap() + p;
+            let id = std::str::from_utf8(&b[p..end]).unwrap().to_string();
+            p = end + 1;
+            assert!(p + 8 <= b.len());
+            let n = usize::try_from(u64::from_le_bytes(b[p..p + 8].try_into().unwrap())).unwrap();
+            p += 8;
+            assert_eq!(expected.get(&id), Some(&n));
+            let len = n.checked_mul(8).unwrap();
+            assert!(len <= b.len() - p);
+            let v: Vec<f64> =
+                b[p..p + len].chunks_exact(8).map(|x| f64::from_le_bytes(x.try_into().unwrap())).collect();
+            assert!(v.iter().all(|x| x.is_finite()));
+            assert!(sums.insert(id, v).is_none());
+            p += len;
+        }
+        if samples.is_empty() {
+            assert!(sums.is_empty())
+        } else {
+            assert_eq!(sums.keys().collect::<Vec<_>>(), expected.keys().collect::<Vec<_>>())
+        }
+        Self { samples: loaded, sums }
+    }
+}
+
+pub fn write_metadata(path: &Path, meta: &BTreeMap<String, String>) {
+    let mut f = OpenOptions::new().create_new(true).write(true).open(path).unwrap();
+    for (k, v) in meta {
+        assert!(!k.contains(['\t', '\n']) && !v.contains(['\t', '\n']));
+        writeln!(f, "{k}\t{v}").unwrap();
+    }
+    f.sync_all().unwrap();
+}
+pub fn read_metadata(path: &Path) -> BTreeMap<String, String> {
+    let mut out = BTreeMap::new();
+    for l in fs::read_to_string(path).unwrap().lines() {
+        let (k, v) = l.split_once('\t').unwrap();
+        assert!(out.insert(k.into(), v.into()).is_none());
+    }
+    out
+}
+fn files(dir: &Path, prefix: &str, out: &mut Vec<String>) {
+    for e in fs::read_dir(dir).unwrap() {
+        let e = e.unwrap();
+        assert!(!e.file_type().unwrap().is_symlink());
+        let name = e.file_name().into_string().unwrap();
+        assert!(!name.contains(['\n', '\t']));
+        let rel = format!("{prefix}{name}");
+        if e.file_type().unwrap().is_dir() {
+            files(&e.path(), &format!("{rel}/"), out)
+        } else if rel != "CHECKSUMS.tsv" {
+            assert!(e.file_type().unwrap().is_file());
+            out.push(rel)
+        }
+    }
+}
+/// Writer has finished every file before publication. A killed save leaves a
+/// .pending directory which is never a resumable checkpoint.
+pub fn seal_and_publish(pending: &Path, final_path: &Path) {
+    assert!(!final_path.exists());
+    let mut list = vec![];
+    files(pending, "", &mut list);
+    list.sort();
+    assert!(list.contains(&"state.tsv".into()));
+    let mut f = OpenOptions::new().create_new(true).write(true).open(pending.join("CHECKSUMS.tsv")).unwrap();
+    for rel in list {
+        let p = pending.join(&rel);
+        File::open(&p).unwrap().sync_all().unwrap();
+        writeln!(f, "{}\t{}\t{}", sha256(&p), fs::metadata(&p).unwrap().len(), rel).unwrap();
+    }
+    f.sync_all().unwrap();
+    File::open(pending).unwrap().sync_all().unwrap();
+    fs::rename(pending, final_path).unwrap();
+    File::open(final_path.parent().unwrap()).unwrap().sync_all().unwrap();
+}
+pub fn verify_checkpoint(dir: &Path) {
+    assert!(!dir.file_name().unwrap().to_string_lossy().contains("pending"));
+    let mut actual = vec![];
+    files(dir, "", &mut actual);
+    actual.sort();
+    let mut listed = vec![];
+    for l in fs::read_to_string(dir.join("CHECKSUMS.tsv")).unwrap().lines() {
+        let v: Vec<_> = l.split('\t').collect();
+        assert_eq!(v.len(), 3);
+        assert!(v[0].len() == 64 && v[0].bytes().all(|x| x.is_ascii_hexdigit()));
+        assert!(!v[2].starts_with('/') && !v[2].split('/').any(|x| x == ".."));
+        let p = dir.join(v[2]);
+        assert_eq!(fs::metadata(&p).unwrap().len(), v[1].parse::<u64>().unwrap());
+        assert_eq!(sha256(&p), v[0]);
+        listed.push(v[2].to_string());
+    }
+    listed.sort();
+    assert_eq!(actual, listed);
+    assert!(listed.contains(&"state.tsv".into()));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn temp(n: &str) -> std::path::PathBuf {
+        let p = std::env::temp_dir().join(format!("zq-bt4-state-{}-{n}", std::process::id()));
+        fs::create_dir(&p).unwrap();
+        p
+    }
+    #[test]
+    fn exposures_round_up_exactly() {
+        let s = Schedule::from_occurrences(100_000_000_000, 16384, 6104);
+        assert_eq!((s.main, s.tail), (3600, 900));
+        assert_eq!(Schedule::from_occurrences(1, 16384, 6104).main, 1);
+    }
+    #[test]
+    fn schedule_boundaries() {
+        let s = Schedule { main: 3600, tail: 900, batch: 16384, batches_per_sb: 6104 };
+        s.validate();
+        assert_eq!(s.lr(3600), s.lr(3601));
+        assert_eq!(s.lr(4500), 0.001 * 0.3f32.powi(5) * 0.1);
+        assert_eq!(s.average_samples_through(4500), (700..=900).step_by(25).map(|x| x + 3600).collect::<Vec<_>>());
+        for i in 2..=4500 {
+            assert!(s.lr(i) <= s.lr(i - 1))
+        }
+        assert!(!s.average_at(4275));
+    }
+    #[test]
+    fn final_once_and_short_tail() {
+        for tail in 1..=101 {
+            let s = Schedule { main: 2, tail, batch: 1, batches_per_sb: 1 };
+            let list = s.average_samples_through(s.total());
+            assert_eq!(list.last(), Some(&s.total()));
+            assert_eq!(list.iter().filter(|&&v| v == s.total()).count(), 1);
+        }
+    }
+    #[test]
+    fn average_resume_and_shape_guard() {
+        let p = temp("average");
+        let shape = BTreeMap::from([("w".into(), 2)]);
+        let mut avg = Average::default();
+        avg.add(25, &BTreeMap::from([("w".into(), vec![1., 3.])]));
+        avg.save(&p.join("a"));
+        let mut resumed = Average::load(&p.join("a"), &shape, &[25]);
+        resumed.add(50, &BTreeMap::from([("w".into(), vec![3., 7.])]));
+        assert_eq!(resumed.mean()["w"], vec![2., 5.]);
+        assert!(
+            std::panic::catch_unwind(std::panic::AssertUnwindSafe(
+                || resumed.add(50, &BTreeMap::from([("w".into(), vec![9., 9.])]))
+            ))
+            .is_err()
+        );
+        fs::remove_dir_all(p).unwrap();
+    }
+    #[test]
+    fn checkpoint_integrity_rejects_tamper_and_extra() {
+        let p = temp("seal");
+        let pending = p.join("sb1.pending");
+        fs::create_dir(&pending).unwrap();
+        write_metadata(&pending.join("state.tsv"), &BTreeMap::from([("sb".into(), "1".into())]));
+        fs::write(pending.join("weights"), b"123").unwrap();
+        let finalp = p.join("sb1");
+        seal_and_publish(&pending, &finalp);
+        verify_checkpoint(&finalp);
+        fs::write(finalp.join("extra"), b"x").unwrap();
+        assert!(std::panic::catch_unwind(|| verify_checkpoint(&finalp)).is_err());
+        fs::remove_file(finalp.join("extra")).unwrap();
+        fs::write(finalp.join("weights"), b"124").unwrap();
+        assert!(std::panic::catch_unwind(|| verify_checkpoint(&finalp)).is_err());
+        fs::remove_dir_all(p).unwrap();
+    }
+    #[test]
+    fn model_and_optimizer_strictness() {
+        let p = temp("model");
+        let vals = BTreeMap::from([("w".into(), vec![1., 2.])]);
+        for n in ["weights.bin", "momentum.bin", "velocity.bin"] {
+            write_tensors(&p.join(n), &vals);
+        }
+        validate_optimizer(&p, &shapes(&vals));
+        fs::write(p.join("momentum.bin"), b"w\n\x02\0\0\0\0\0\0\0").unwrap();
