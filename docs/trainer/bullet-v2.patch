+//! zigqueen v2 net trainer (built by lane lever/b3-pawn-pairs-20260930; production by lane
+//! b12-trainer-20260930 from the reviewed handover).
+//!
+//! v2 = BT4 architecture (FT 1024 pairwise CReLU, 8 material layerstacks 16->32->1, trained PSQT)
+//!    + 16 king buckets (B2 arm (e) layout: each deployed bucket split in two)
+//!    + PP1 pawn-pair rows (docs/research/B3_PAWN_PAIRS_DESIGN_2026-09-30.md), deployed as ZQBA.
+//! Fresh BT4-procedure init (`init --seed 62020914`), then BT4's recipe unchanged: the BT4 data
+//! stream (lane index, seed 62020914, 2^26 shuffle window), 5,902 superbatches of 6,104 x 16,384
+//! (main 4,721: cosine 0.001 -> 0.001*0.3^5; tail 1,181: -> 0.1x; BT4 zq_bt4_state Schedule),
+//! BT4 checkpoint rule (every 25 SB, SB 1, the main endpoint, the end), BT4 late-weight averaging
+//! (tail SBs local%25==0 in the last quarter, plus the end), then head QAT (zq_v2_head_qat) and the
+//! ZQBA export (tools/v2).
+//!
+//! Finish stage: config `finish_qat` off (BT4: float graph through SB 5,902) or on (the tail
+//! SB 4,722.. runs the deployed-arithmetic forward with straight-through estimators, B1's graph
+//! with the pawn block quantised like the threat block). A run started with `off` may switch to
+//! `on` only by resuming from its main-endpoint checkpoint with a config that differs in
+//! `finish_qat` alone (see `train`). Not decided by this trainer.
+//!
+//! Own code. Adapted from lane b12's zq_b12.rs (sha256 in tools/v2/SOURCES.sha256: train loop,
+//! stream digests, checkpoints, resume roundtrip, held-out, init, features, B1 split/QAT graph)
+//! and from zq_b3_pp.rs (pawn block, dead-row invariants). No foreign engine code.
+//!
+//! Modes:
+//!   train    --config C.tsv --output NEW [--resume CP] [--max-sb N]
+//!   init     --seed S --output NEW                 (fresh BT4-procedure init, dead PP1 rows zero)
+//!   export   --named W.bin --output NEW            (float-layout masters -> bullet quantised.bin)
+//!   probe    --named W.bin --fens F --graph float|qat --output NEW   (GPU forward outputs)
+//!   features --fens F --out F.tsv                  (trainer features, CPU)
+//!   stream-scan --manifest M --seed S --shuffle N --sb-records R --sbs a,b,.. --out F   (CPU)
+//!   constants                                      (layout constants, CPU)
+use bullet_compiler::tensor::TValue;
+use bullet_lib::{
+    game::{
+        inputs::{Chess768, ChessBucketsMirrored, Combined, Factorised, FullThreatInputs60k, PawnPairInputsPP1, SparseInputType},
+        outputs::MaterialCount,
+    },
+    nn::{
+        ExecutionContext, InitSettings, Shape,
+        optimiser::{AdamW, AdamWParams},
+    },
+    trainer::save::SavedFormat,
+    value::{ValueTrainerBuilder, dataloader::ValueDataLoader, save},
+};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    fs::{File, OpenOptions},
+    io::Write,
+    path::{Path, PathBuf},
+    time::Instant,
+};
+use zq_bt4_loader::PrefetchStream;
+
+mod zq_bt4_state;
+use zq_bt4_state as st;
+
+const FT: usize = 1024;
+const FAC: usize = 768;
+const KING_BUCKETS: usize = 16;
+const HALFKA: usize = 768 * KING_BUCKETS;
+const THREAT: usize = 60144;
+const PAWN: usize = bullet_lib::game::inputs::pawn_pairs::PP1_INPUTS;
+const PAWN0: usize = FAC + HALFKA + THREAT;
+const ROWS: usize = FAC + HALFKA + THREAT + PAWN;
+const DEPLOYED: usize = HALFKA + THREAT + PAWN;
+const L2: usize = 16;
+const L3: usize = 32;
+const NB: usize = 8;
+const QA: i16 = 255;
+const QB: i16 = 64;
+const BATCH: usize = 16_384;
+#[rustfmt::skip]
+const BUCKET_LAYOUT: [usize; 32] = [
+    0, 1, 2, 3, 4, 5, 6, 7, 8, 8, 9, 9, 10, 10, 11, 11, 12, 12, 13, 13, 12, 12, 13, 13, 14, 14, 15, 15, 14, 14, 15, 15,
+];
+const TARGET_DIVISOR: f32 = (800.0_f64 / 0.9256841495771224_f64) as f32;
+const DECODE_WORKERS: usize = 4;
+const BT4_MAIN: usize = 4721;
+const BT4_TAIL: usize = 1181;
+const BT4_BPS: usize = 6104;
+const BT4_SEED: usize = 62020914;
+const BT4_SHUFFLE: usize = 1 << 26;
+const FROZEN_INDEX: &str = "e9e87c68a8563c6588fc09edc2dc594b7743e69f3e066788607086c23bedcd4c";
+const VARIANT: &str = "v2-kb16-pp1";
+const SCHEMA: &str = "zq_v2_train_v1";
+const CHECKPOINT_SCHEMA: &str = "zq_v2_checkpoint_v1";
+const PIECE_VALUE_CP: [f32; 6] = [126.0, 781.0, 825.0, 1276.0, 2538.0, 0.0];
+
+type OwnInputs = Combined<Combined<Factorised<ChessBucketsMirrored, Chess768>, FullThreatInputs60k>, PawnPairInputsPP1>;
+type Trainer =
+    bullet_lib::value::ValueTrainer<bullet_lib::nn::optimiser::AdamWOptimiser, OwnInputs, MaterialCount<NB>>;
+
+fn inputs() -> OwnInputs {
+    let i = Combined::new(
+        Combined::new(Factorised::from_parts(ChessBucketsMirrored::new(BUCKET_LAYOUT), Chess768), FullThreatInputs60k::new()),
+        PawnPairInputsPP1::from_arm("real"),
+    );
+    assert_eq!(i.num_inputs(), ROWS, "v2 input rows");
+    i
+}
+
+fn is_dead_pawn_row(p: usize) -> bool {
+    !bullet_lib::game::inputs::pawn_pairs::pp1_is_live(p)
+}
+
+/// zq_bt4_full.rs save format with the pawn block appended after the threat block (as the
+/// pilot): factoriser folded into the HalfKA rows, l0 i16 QA, l1 i8 QB, the rest f32.
+fn save_format() -> Vec<SavedFormat> {
+    vec![
+        SavedFormat::id("l0w")
+            .transform(|_store, weights| {
+                let mut out = vec![0.0f32; DEPLOYED * FT];
+                for h in 0..HALFKA {
+                    let fac_col = h % FAC;
+                    let halfka_src = FAC + h;
+                    for o in 0..FT {
+                        out[o + FT * h] = weights[o + FT * halfka_src] + weights[o + FT * fac_col];
+                    }
+                }
+                for t in 0..THREAT + PAWN {
+                    let src = FAC + HALFKA + t;
+                    for o in 0..FT {
+                        out[o + FT * (HALFKA + t)] = weights[o + FT * src];
+                    }
+                }
+                out
+            })
+            .round()
+            .quantise::<i16>(QA),
+        SavedFormat::id("l0b").round().quantise::<i16>(QA),
+        SavedFormat::id("l1w").transpose().round().quantise::<i8>(QB),
+        SavedFormat::id("l1b"),
+        SavedFormat::id("l2w").transpose(),
+        SavedFormat::id("l2b"),
+        SavedFormat::id("l3w").transpose(),
+        SavedFormat::id("l3b"),
+        SavedFormat::id("psqtw").transform(|_store, weights| {
+            let mut out = vec![0.0f32; DEPLOYED];
+            for h in 0..HALFKA {
+                out[h] = weights[FAC + h] + weights[h % FAC];
+            }
+            for t in 0..THREAT + PAWN {
+                out[HALFKA + t] = weights[FAC + HALFKA + t];
+            }
+            out
+        }),
+        SavedFormat::id("psqtb"),
+    ]
+}
+
+// ---------------------------------------------------------------- graphs
+
+static INIT_SEED: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+
+/// The zq_bt4_full.rs float graph (zq_b12 b2 graph at power 2, no penalty) on the v2 inputs.
+/// probe=true outputs [output, stm CReLU(1024), ntm CReLU(1024), pairs(1024)] per row.
+fn float_trainer(probe: bool) -> Trainer {
+    ValueTrainerBuilder::default()
+        .dual_perspective()
+        .optimiser(AdamW)
+        .inputs(inputs())
+        .output_buckets(MaterialCount::<NB>)
+        .save_format(&save_format())
+        .build_custom(move |builder, (stm, ntm, output_buckets), targets| {
+            if let Some(seed) = INIT_SEED.get() {
+                builder.set_initialization_seed(*seed); // `init` mode only; training loads a file
+            }
+            let l0 = builder.new_affine("l0", ROWS, FT);
+            l0.init_with_effective_input_size(192);
+            let psqt = builder.new_affine("psqt", ROWS, 1);
+            let l1 = builder.new_affine("l1", FT, NB * L2);
+            let l2 = builder.new_affine("l2", L2, NB * L3);
+            let l3 = builder.new_affine("l3", L3, NB);
+            let comb = builder.new_affine("comb", 2, 1);
+            let stm_act = l0.forward(stm).crelu();
+            let ntm_act = l0.forward(ntm).crelu();
+            let hl1 = stm_act.pairwise_mul().concat(ntm_act.pairwise_mul());
+            let hl2 = l1.forward(hl1).select(output_buckets).screlu();
+            let hl3 = l2.forward(hl2).select(output_buckets).screlu();
+            let main_out = l3.forward(hl3).select(output_buckets);
+            let psqt_base = psqt.forward(stm);
+            let out = comb.forward(main_out.concat(psqt_base));
+            let total = out.sigmoid().squared_error(targets);
+            (if probe { out.concat(stm_act).concat(ntm_act).concat(hl1) } else { out }, total)
+        })
+}
+
+/// B1's split-FT graph (zq_b12 b1_trainer) with a fourth FT block `pawn` (the PP1 rows).
+/// qat=false: float forward, the same function as `float_trainer`. qat=true: deployed arithmetic
+/// with straight-through estimators: merged HalfKA = round_half_away(255*(base + factor[h%768])),
+/// threat and pawn = clamp(round(255*w), -127, 127) (the converter's i8 rule for both blocks),
+/// bias = round(255*b); accumulator clamp 0..255, pair product >>8, L1 = round(64*w) i8 with exact
+/// integer dot and the deployed f32 dequant/L2/L3 order. PSQT stays the float affine.
+/// probe=true (qat only) outputs B1's probe layout: [acc_s, acc_n, s|n, dots, z1, z2, main, out].
+fn split_trainer(qat: bool, probe: bool) -> Trainer {
+    ValueTrainerBuilder::default()
+        .dual_perspective()
+        .optimiser(AdamW)
+        .inputs(inputs())
+        .output_buckets(MaterialCount::<NB>)
+        .save_format(&[SavedFormat::id("l1w")]) // unused: exports go through `export` on merged masters
+        .build_custom(move |b, (stm, ntm, buckets), targets| {
+            b.set_initialization_seed(BT4_SEED as u64); // every tensor is loaded from a checkpoint
+            let factor = b.new_weights("factor", Shape::new(FAC * FT, 1), InitSettings::Zeroed);
+            let base = b.new_weights("base", Shape::new(HALFKA * FT, 1), InitSettings::Zeroed);
+            let threat = b.new_weights("threat", Shape::new(THREAT * FT, 1), InitSettings::Zeroed);
+            let pawn = b.new_weights("pawn", Shape::new(PAWN * FT, 1), InitSettings::Zeroed);
+            let l0b = b.new_weights("l0b", Shape::new(FT, 1), InitSettings::Zeroed);
+            let psqt = b.new_affine("psqt", ROWS, 1);
+            let l1 = b.new_affine("l1", FT, NB * L2);
+            let l2 = b.new_affine("l2", L2, NB * L3);
+            let l3 = b.new_affine("l3", L3, NB);
+            let comb = b.new_affine("comb", 2, 1);
+            let psqt_base = psqt.forward(stm);
+            let mut probe_nodes = None;
+            let main = if qat {
+                let mut tiled = factor;
+                for _ in 1..KING_BUCKETS {
+                    tiled = tiled.concat(factor);
+                }
+                let merged = (base + tiled) * 255.0;
+                let qmerged = merged.faux_quantise(1.0, true);
+                let qthreat = (threat * 255.0).faux_quantise(1.0, true).max(-127.0).min(127.0);
+                let qpawn = (pawn * 255.0).faux_quantise(1.0, true).max(-127.0).min(127.0);
+                let qbias = (l0b * 255.0).faux_quantise(1.0, true);
+                let w = (factor * 0.0).concat(qmerged).concat(qthreat).concat(qpawn).reshape(Shape::new(FT, ROWS));
+                let acc_s = w.matmul(stm) + qbias;
+                let acc_n = w.matmul(ntm) + qbias;
+                let s = (acc_s.max(0.0).min(255.0).pairwise_mul() / 256.0).faux_quantise(1.0, false);
+                let n = (acc_n.max(0.0).min(255.0).pairwise_mul() / 256.0).faux_quantise(1.0, false);
+                let dots = (l1.weights.faux_quantise(64.0, true) * 64.0).matmul(s.concat(n));
+                let z1 = dots.zq_scaled_add(l1.bias, 256.0 / (64.0 * 255.0 * 255.0)).select(buckets);
+                let z2 = l2.weights.zq_ordered_affine(z1.screlu(), l2.bias, false).select(buckets);
+                let main = l3.weights.zq_ordered_affine(z2.screlu(), l3.bias, true).select(buckets);
+                probe_nodes = Some(acc_s.concat(acc_n).concat(s.concat(n)).concat(dots).concat(z1).concat(z2).concat(main));
+                main
+            } else {
+                let w = factor.concat(base).concat(threat).concat(pawn).reshape(Shape::new(FT, ROWS));
+                let stm_hidden = (w.matmul(stm) + l0b).crelu().pairwise_mul();
+                let ntm_hidden = (w.matmul(ntm) + l0b).crelu().pairwise_mul();
+                let hl1 = stm_hidden.concat(ntm_hidden);
+                let hl2 = l1.forward(hl1).select(buckets).screlu();
+                let hl3 = l2.forward(hl2).select(buckets).screlu();
+                l3.forward(hl3).select(buckets)
+            };
+            let out = comb.forward(main.concat(psqt_base));
+            let shown = match (probe, probe_nodes) {
+                (true, Some(p)) => p.concat(out),
+                (true, None) => panic!("probe needs qat=on"),
+                _ => out,
+            };
+            (shown, out.sigmoid().squared_error(targets))
+        })
+}
+
+/// zq_bt4_full.rs optimiser constraints (l0 +-0.99, PSQT +-16 no decay, combiner clamped to
+/// [1,1]/0 within 1e-4), for either FT layout.
+fn bt4_params(trainer: &mut Trainer, split: bool) {
+    let stricter_clipping = AdamWParams { max_weight: 0.99, min_weight: -0.99, ..Default::default() };
+    let l0: &[&str] = if split { &["factor", "base", "threat", "pawn"] } else { &["l0w"] };
+    for name in l0 {
+        trainer.optimiser.set_params_for_weight(name, stricter_clipping);
+    }
+    let psqt_clipping = AdamWParams { max_weight: 16.0, min_weight: -16.0, decay: 0.0, ..Default::default() };
+    trainer.optimiser.set_params_for_weight("psqtw", psqt_clipping);
+    trainer.optimiser.set_params_for_weight("psqtb", psqt_clipping);
+    let freeze_w = AdamWParams { max_weight: 1.0001, min_weight: 0.9999, decay: 0.0, ..Default::default() };
+    let freeze_b = AdamWParams { max_weight: 0.0001, min_weight: -0.0001, decay: 0.0, ..Default::default() };
+    trainer.optimiser.set_params_for_weight("combw", freeze_w);
+    trainer.optimiser.set_params_for_weight("combb", freeze_b);
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Graph {
+    Float,
+    Split { qat: bool },
+}
+impl Graph {
+    fn name(self) -> &'static str {
+        match self {
+            Graph::Float => "float",
+            Graph::Split { qat: false } => "split-float",
+            Graph::Split { qat: true } => "split-qat",
+        }
+    }
+    fn layout(self) -> &'static str {
+        if self == Graph::Float { "float" } else { "split" }
+    }
+}
+
+fn build(graph: Graph) -> Trainer {
+    let mut t = match graph {
+        Graph::Float => float_trainer(false),
+        Graph::Split { qat } => split_trainer(qat, false),
+    };
+    bt4_params(&mut t, graph != Graph::Float);
+    t
+}
+
+fn model_shapes(trainer: &Trainer) -> BTreeMap<String, usize> {
+    trainer.optimiser.model.weights().iter().map(|(k, v)| (k.clone(), v.size())).collect()
+}
+
+fn trainable(trainer: &Trainer) -> Vec<String> {
+    let gradients = trainer.optimiser.model.make_gradient_tensors().unwrap();
+    gradients.keys().cloned().collect()
+}
+
+/// Bounds (the BT4 clamps) and the v2 invariant: every dead PP1 row and its PSQT entry exactly +0.
+fn bounds(values: &st::Tensors) {
+    for (id, v) in values {
+        let (lo, hi) = match id.as_str() {
+            "l0w" | "factor" | "base" | "threat" | "pawn" => (-0.99, 0.99),
+            "psqtw" | "psqtb" => (-16.0, 16.0),
+            "combw" => (0.9999, 1.0001),
+            "combb" => (-0.0001, 0.0001),
+            _ => (-1.98, 1.98),
+        };
+        assert!(v.iter().all(|&x| x.is_finite() && x >= lo && x <= hi), "KILL: bound {id}");
+    }
+    let pawn_rows: Option<&[f32]> = if let Some(p) = values.get("pawn") {
+        Some(p)
+    } else {
+        values.get("l0w").map(|w| &w[PAWN0 * FT..])
+    };
+    let pawn_rows = pawn_rows.expect("FT tensor");
+    assert_eq!(pawn_rows.len(), PAWN * FT);
+    for p in (0..PAWN).filter(|&p| is_dead_pawn_row(p)) {
+        assert!(pawn_rows[p * FT..(p + 1) * FT].iter().all(|x| x.to_bits() == 0), "KILL: dead PP1 row {p} moved");
+        assert_eq!(values["psqtw"][PAWN0 + p].to_bits(), 0, "KILL: dead PP1 PSQT {p} moved");
+    }
+}
+
+/// Float layout l0w (col-major FT x ROWS) <-> factor | base | threat | pawn column blocks.
+fn split_l0w(mut t: st::Tensors) -> st::Tensors {
+    let l0w = t.remove("l0w").expect("l0w");
+    assert_eq!(l0w.len(), FT * ROWS);
+    t.insert("factor".into(), l0w[..FT * FAC].to_vec());
+    t.insert("base".into(), l0w[FT * FAC..FT * (FAC + HALFKA)].to_vec());
+    t.insert("threat".into(), l0w[FT * (FAC + HALFKA)..FT * PAWN0].to_vec());
+    t.insert("pawn".into(), l0w[FT * PAWN0..].to_vec());
+    t
+}
+fn merge_l0w(mut t: st::Tensors) -> st::Tensors {
+    let mut l0w = t.remove("factor").expect("factor");
+    l0w.extend(t.remove("base").expect("base"));
+    l0w.extend(t.remove("threat").expect("threat"));
+    l0w.extend(t.remove("pawn").expect("pawn"));
+    assert_eq!(l0w.len(), FT * ROWS);
+    t.insert("l0w".into(), l0w);
+    t
+}
+fn to_layout(t: st::Tensors, layout: &str) -> st::Tensors {
+    match (t.contains_key("l0w"), layout) {
+        (true, "float") | (false, "split") => t,
+        (true, "split") => split_l0w(t),
+        (false, "float") => merge_l0w(t),
+        _ => unreachable!(),
+    }
+}
+
+// ---------------------------------------------------------------- schedule
+
+/// BT4 checkpoint rule generalised to `every` (production: every == 25 equals
+/// zq_bt4_state::Schedule::checkpoint exactly; tested).
+fn checkpoint_at(s: st::Schedule, every: usize, sb: usize) -> bool {
+    sb == 1
+        || sb == s.main
+        || sb == s.total()
+        || (sb <= s.main && sb % every == 0)
+        || (sb > s.main && (sb - s.main) % every == 0)
+}
+
+// ---------------------------------------------------------------- config / identity
+
+fn read_tsv(path: impl AsRef<Path>) -> BTreeMap<String, String> {
+    st::read_metadata(path.as_ref())
+}
+fn key<'a>(cfg: &'a BTreeMap<String, String>, k: &str) -> &'a str {
+    cfg.get(k).unwrap_or_else(|| panic!("missing config {k}"))
+}
+fn num(cfg: &BTreeMap<String, String>, k: &str) -> usize {
+    key(cfg, k).parse().unwrap_or_else(|_| panic!("config {k} not an integer"))
+}
+fn check_hash(cfg: &BTreeMap<String, String>, name: &str) {
+    let path = key(cfg, name);
+    if path != "none" {
+        assert_eq!(st::sha256(Path::new(path)), key(cfg, &format!("{name}_sha256")), "input hash {name}");
+    }
+}
+
+const KEYS: [&str; 25] = [
+    "schema", "lane", "mode", "init", "init_sha256", "source_index", "source_index_sha256", "frozen_index_sha256",
+    "target_contract_sha256", "seed", "shuffle_records", "batch_size", "batches_per_sb", "main_sb", "tail_sb",
+    "checkpoint_every_sb", "finish_qat", "threads", "validation_records", "validation_records_sha256",
+    "stream_reference", "stream_reference_sha256", "runtime_cap_seconds", "min_free_disk_bytes", "prereg_sha256",
+];
+
+fn validate_config(cfg: &BTreeMap<String, String>) {
+    let mut want = KEYS.to_vec();
+    want.sort();
+    let keys: Vec<&str> = cfg.keys().map(String::as_str).collect();
+    assert_eq!(keys, want, "config keys");
+    assert_eq!(key(cfg, "schema"), SCHEMA);
+    assert!(!key(cfg, "lane").is_empty());
+    let mode = key(cfg, "mode");
+    assert!(["production", "readiness"].contains(&mode), "mode");
+    assert!(["off", "on"].contains(&key(cfg, "finish_qat")), "finish_qat");
+    assert!((1..=8).contains(&num(cfg, "threads")));
+    assert_eq!(num(cfg, "batch_size"), BATCH);
+    let (bps, main, tail, every) = (num(cfg, "batches_per_sb"), num(cfg, "main_sb"), num(cfg, "tail_sb"), num(cfg, "checkpoint_every_sb"));
+    assert!(bps >= 1 && main >= 1 && tail >= 2 && every >= 1);
+    assert!(num(cfg, "shuffle_records") >= 1);
+    if mode == "production" {
+        assert_eq!((bps, main, tail, every), (BT4_BPS, BT4_MAIN, BT4_TAIL, 25), "BT4 schedule and checkpoint rule");
+        assert_eq!(num(cfg, "seed"), BT4_SEED, "BT4 seed");
+        assert_eq!(num(cfg, "shuffle_records"), BT4_SHUFFLE, "BT4 shuffle window");
+    }
+    for name in ["init", "source_index", "validation_records", "stream_reference"] {
+        check_hash(cfg, name);
+    }
+    lane_index_check(key(cfg, "source_index"), key(cfg, "frozen_index_sha256"));
+}
+
+fn load_config(path: &str) -> BTreeMap<String, String> {
+    let cfg = read_tsv(path);
+    validate_config(&cfg);
+    cfg
+}
+
+/// The lane index must equal the frozen BT4 index except the three cache fields (zq_b12 rule:
+/// a receipt beside the lane index binds both hashes).
+fn lane_index_check(lane: &str, frozen_sha: &str) {
+    assert_eq!(frozen_sha, FROZEN_INDEX);
+    let receipt = Path::new(lane).parent().unwrap().join("lane-manifest-receipt.json");
+    let text = std::fs::read_to_string(&receipt).expect("lane manifest receipt");
+    assert!(text.contains(frozen_sha), "lane receipt does not bind the frozen index");
+    assert!(text.contains(&st::sha256(Path::new(lane))), "lane receipt does not bind this lane index");
+}
+
+/// Resume rule: the exact config, or (only at the main endpoint) a config that differs in
+/// `finish_qat` alone. Returns true for such a finish switch.
+fn resume_config_ok(old: &BTreeMap<String, String>, new: &BTreeMap<String, String>, completed_sb: usize) -> bool {
+    if old == new {
+        return false;
+    }
+    let differing: Vec<&String> = old.keys().filter(|k| old.get(*k) != new.get(*k)).collect();
+    assert!(old.keys().eq(new.keys()), "resume: config keys changed");
+    assert_eq!(differing, vec!["finish_qat"], "resume only this exact run (or a finish_qat switch)");
+    assert_eq!(completed_sb, num(new, "main_sb"), "finish_qat may change only at the main endpoint");
+    true
+}
+
+fn read_reference(cfg: &BTreeMap<String, String>) -> Option<BTreeMap<u64, String>> {
+    let path = key(cfg, "stream_reference");
+    if path == "none" {
+        return None;
+    }
+    let mut out = BTreeMap::new();
+    for line in std::fs::read_to_string(path).unwrap().lines() {
+        let f: Vec<&str> = line.split('\t').collect();
+        assert_eq!(f.len(), 3);
+        assert!(out.insert(f[1].parse().unwrap(), f[2].to_string()).is_none());
+    }
+    Some(out)
+}
+
+fn canonical(row: &bulletformat::ChessBoard, out: &mut Vec<u8>) {
+    // Same canonical 32-byte logical record as zq_b12 / zq_bt4_jq.
+    out.extend_from_slice(&row.occ.to_le_bytes());
+    out.extend_from_slice(&row.pcs);
+    out.extend_from_slice(&row.score.to_le_bytes());
+    out.extend_from_slice(&[row.result, row.ksq, row.opp_ksq]);
+    out.extend_from_slice(&row.extra);
+}
+
+// ---------------------------------------------------------------- data stream with per-SB digests (zq_b12)
+
+#[derive(Clone)]
+struct Stream {
+    manifest: String,
+    paths: Vec<String>,
+    seed: u64,
+    shuffle: usize,
+    batch: usize,
+    sb_records: usize,
+    end_position: usize,
+    digest_log: PathBuf,
+    reference: Option<BTreeMap<u64, String>>,
+}
+impl bullet_lib::value::loader::DataLoader<bulletformat::ChessBoard> for Stream {
+    fn data_file_paths(&self) -> &[String] {
+        &self.paths
+    }
+    fn map_chunks<F: FnMut(&[bulletformat::ChessBoard]) -> bool>(&self, start_position: usize, mut f: F) {
+        assert!(start_position % self.sb_records == 0 && start_position < self.end_position);
+        let mut stream = PrefetchStream::open(&self.manifest, self.seed, self.shuffle, start_position as u64).unwrap();
+        assert_eq!(stream.decode_workers(), DECODE_WORKERS, "frozen source decoder concurrency changed");
+        let mut log = OpenOptions::new().append(true).open(&self.digest_log).unwrap();
+        let mut hasher = Sha256::new();
+        let mut buffer = Vec::with_capacity(self.batch * 32);
+        let mut position = start_position;
+        loop {
+            let rows = stream.next_batch(self.batch).expect("BT4 source loader failed");
+            assert_eq!(rows.len(), self.batch, "incomplete batch");
+            buffer.clear();
+            for row in &rows {
+                canonical(row, &mut buffer);
+            }
+            hasher.update(&buffer);
+            position += rows.len();
+            if position % self.sb_records == 0 {
+                let sb = position / self.sb_records;
+                let start = (position - self.sb_records) as u64;
+                let digest = format!("{:x}", hasher.finalize_reset());
+                writeln!(log, "{sb}\t{start}\t{digest}").unwrap();
+                log.sync_data().unwrap();
+                if let Some(expected) = self.reference.as_ref().and_then(|r| r.get(&start)) {
+                    assert_eq!(expected, &digest, "KILL: stream identity mismatch at record {start} (sb {sb})");
+                    println!("v2_stream_identity\tmatch\t{sb}\t{start}");
+                }
+            }
+            let stop = f(&rows);
+            assert_eq!(stop, position == self.end_position, "unexpected data stop");
+            if stop {
+                break;
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------- shared helpers
+
+fn free_disk(path: &Path) -> u64 {
+    let out = std::process::Command::new("df").args(["-B1", "--output=avail"]).arg(path).output().unwrap();
+    String::from_utf8(out.stdout).unwrap().lines().nth(1).unwrap().trim().parse().unwrap()
+}
+fn nonfinite_updates() -> f32 {
+    bullet_trainer::optimiser::adam::nonfinite_update_count::<ExecutionContext>().unwrap_or(0.0)
+}
+fn board_from_raw(raw: &[u8]) -> bulletformat::ChessBoard {
+    assert!(raw[26] <= 2 && raw[27] < 64 && raw[28] < 64);
+    bulletformat::ChessBoard {
+        occ: u64::from_le_bytes(raw[..8].try_into().unwrap()),
+        pcs: raw[8..24].try_into().unwrap(),
+        score: i16::from_le_bytes(raw[24..26].try_into().unwrap()),
+        result: raw[26],
+        ksq: raw[27],
+        opp_ksq: raw[28],
+        extra: raw[29..32].try_into().unwrap(),
+    }
+}
+fn forward_host(trainer: &mut Trainer, host: bullet_trainer::run::dataloader::PreparedBatchHost, n: usize) -> Vec<f32> {
+    let model = &mut trainer.optimiser.model;
+    model.set_fwd_batch_size(n).unwrap();
+    let device = model.device();
+    let stream = device.new_stream().unwrap();
+    let inputs = host.to_device(&device).unwrap();
+    let outputs = model.make_forward_output_tensors(n).unwrap();
+    model.forward(&stream, &inputs, &outputs).unwrap().value().unwrap();
+    let TValue::F32(raw) = outputs["outputs/output"].to_host().unwrap() else { panic!("nonfloat output") };
+    raw
+}
+/// Held-out fixture: raw outputs and MSE against the recipe target (result weight 0.1).
+fn evaluate_holdout(trainer: &mut Trainer, cfg: &BTreeMap<String, String>, output: &Path, label: &str) -> f64 {
+    let bytes = std::fs::read(key(cfg, "validation_records")).unwrap();
+    assert_eq!(bytes.len() % 32, 0);
+    let rows: Vec<bulletformat::ChessBoard> = bytes.chunks_exact(32).map(board_from_raw).collect();
+    let mut outputs = std::io::BufWriter::new(File::create(output.join(format!("heldout-{label}.outputs.f32le"))).unwrap());
+    let mut se = 0.0_f64;
+    for batch in rows.chunks(4096) {
+        let host = trainer.state.prepare(batch, num(cfg, "threads"), 0.1, TARGET_DIVISOR);
+        let TValue::F32(targets) = &host.inputs["targets"] else { panic!("nonfloat targets") };
+        let targets = targets.clone();
+        let raw = forward_host(trainer, host, batch.len());
+        assert_eq!(raw.len(), batch.len());
+        for (prediction, target) in raw.into_iter().zip(targets) {
+            assert!(prediction.is_finite() && target.is_finite());
+            let p = 1.0 / (1.0 + (-f64::from(prediction)).exp());
+            se += (p - f64::from(target)).powi(2);
+            outputs.write_all(&prediction.to_le_bytes()).unwrap();
+        }
+    }
+    outputs.flush().unwrap();
+    let mse = se / rows.len() as f64;
+    std::fs::write(output.join(format!("heldout-{label}.tsv")), format!("count\t{}\nmse\t{mse:.12e}\n", rows.len())).unwrap();
+    println!("v2_holdout\t{label}\t{}\t{mse:.12e}", rows.len());
+    mse
+}
+
+fn current_values(trainer: &Trainer, scratch: &Path) -> st::Tensors {
+    let tmp = scratch.join("values.tmp");
+    trainer.optimiser.model.write_to(&mut File::create(&tmp).unwrap()).unwrap();
+    let v = st::read_tensors(&tmp);
+    std::fs::remove_file(&tmp).unwrap();
+    v
+}
+
+/// Load a published checkpoint's optimiser state into `trainer` (converting the FT layout when
+/// the checkpoint was written by the other graph) and prove the load/save roundtrip.
+fn load_state(trainer: &mut Trainer, cp: &Path, shapes: &BTreeMap<String, usize>, layout: &str, scratch: &Path) {
+    let opt = cp.join("optimiser_state");
+    let src_layout = read_tsv(cp.join("state.tsv"))["layout"].clone();
+    let source = if src_layout == layout {
+        opt.clone()
+    } else {
+        let conv = scratch.join("converted-optimiser-state.tmp");
+        std::fs::create_dir(&conv).unwrap();
+        for n in ["weights.bin", "momentum.bin", "velocity.bin"] {
+            let t = st::read_tensors(&opt.join(n));
+            let c = to_layout(t.clone(), layout);
+            assert!(to_layout(c.clone(), &src_layout) == t, "layout conversion is not exact for {n}");
+            st::write_tensors(&conv.join(n), &c);
+        }
+        println!("v2_layout_convert\t{src_layout}->{layout}\t{}", cp.display());
+        conv
+    };
+    st::validate_optimizer(&source, shapes);
+    bounds(&st::read_tensors(&source.join("weights.bin")));
+    trainer.optimiser.load_from_checkpoint(source.to_str().unwrap()).unwrap();
+    let roundtrip = scratch.join("resume-roundtrip.tmp");
+    std::fs::create_dir(&roundtrip).unwrap();
+    trainer.optimiser.write_to_checkpoint(roundtrip.to_str().unwrap()).unwrap();
+    for n in ["weights.bin", "momentum.bin", "velocity.bin"] {
+        let a = st::read_tensors(&source.join(n));
+        let b = st::read_tensors(&roundtrip.join(n));
+        let bits = |t: &st::Tensors| -> Vec<(String, Vec<u32>)> {
+            t.iter().map(|(k, v)| (k.clone(), v.iter().map(|x| x.to_bits()).collect())).collect()
+        };
+        assert!(bits(&a) == bits(&b), "resume roundtrip changed {n}");
+    }
+    std::fs::remove_dir_all(roundtrip).unwrap();
+    if source != opt {
+        std::fs::remove_dir_all(source).unwrap();
+    }
+}
+
+// ---------------------------------------------------------------- training
+
+struct Run {
+    cfg: BTreeMap<String, String>,
+    config_sha: String,
+    output: PathBuf,
+    schedule: st::Schedule,
+    every: usize,
+    sb_records: usize,
+    digest_log: PathBuf,
+    progress: File,
+    started: Instant,
+    prior_runtime: f64,
+    average: st::Average,
+    published: Vec<PathBuf>,
+    average_layout: Option<String>,
+}
+
+/// Graph for superbatch `sb` under this config.
+fn graph_for(cfg: &BTreeMap<String, String>, sb: usize) -> Graph {
+    if key(cfg, "finish_qat") == "on" && sb > num(cfg, "main_sb") { Graph::Split { qat: true } } else { Graph::Float }
+}
+
+/// Train superbatches first..=last with one graph (one bullet `train_custom` call).
+fn run_segment(run: &mut Run, trainer: &mut Trainer, graph: Graph, first: usize, last: usize) {
+    let cfg = run.cfg.clone();
+    let bps = num(&cfg, "batches_per_sb");
+    let shapes = model_shapes(trainer);
+    let cap = key(&cfg, "runtime_cap_seconds").parse::<f64>().unwrap();
+    let min_free = key(&cfg, "min_free_disk_bytes").parse::<u64>().unwrap();
+    let steps = bullet_trainer::run::schedule::TrainingSteps {
+        batch_size: BATCH,
+        batches_per_superbatch: bps,
+        start_superbatch: first,
+        end_superbatch: last,
+    };
+    let stream = Stream {
+        manifest: key(&cfg, "source_index").to_string(),
+        paths: vec![key(&cfg, "source_index").to_string()],
+        seed: num(&cfg, "seed") as u64,
+        shuffle: num(&cfg, "shuffle_records"),
+        batch: BATCH,
+        sb_records: run.sb_records,
+        end_position: last * run.sb_records,
+        digest_log: run.digest_log.clone(),
+        reference: read_reference(&cfg),
+    };
+    let data = trainer.state.make_dataloader(stream, TARGET_DIVISOR);
+    let data = ValueDataLoader {
+        steps,
+        threads: num(&cfg, "threads"),
+        dataloader: data,
+        wdl: bullet_lib::trainer::schedule::wdl::ConstantWDL { value: 0.1 },
+    };
+    let schedule = run.schedule;
+    let every = run.every;
+    let train_start = Instant::now();
+    let mut updates = 0usize;
+    let log_every = if key(&cfg, "mode") == "production" { 32 } else { 1 };
+    let started = run.started;
+    let prior_runtime = run.prior_runtime;
+    let sb_records = run.sb_records;
+    let output = run.output.clone();
+    let config_sha = run.config_sha.clone();
+    let digest_log = run.digest_log.clone();
+    let main_sb = schedule.main;
+    let progress = &mut run.progress;
+    let average = &mut run.average;
+    let published = &mut run.published;
+    let average_layout = &mut run.average_layout;
+    trainer
+        .train_custom(
+            bullet_trainer::run::schedule::TrainingSchedule {
+                steps,
+                log_rate: 256,
+                lr_schedule: Box::new(move |_, sb| schedule.lr(sb)),
+            },
+            data,
+            |_, sb, b, loss| {
+                assert!(loss.is_finite(), "KILL: nonfinite loss at sb {sb} batch {b}");
+                updates += 1;
+                if b % log_every == 0 || b == 1 || b == bps {
+                    let bad = nonfinite_updates();
+                    assert!(bad == 0.0, "KILL: {bad} nonfinite AdamW element updates at sb {sb} batch {b}");
+                    let n = ((sb - 1) * bps + b) * BATCH;
+                    let e = train_start.elapsed().as_secs_f64();
+                    writeln!(
+                        progress,
+                        "{sb}\t{b}\t{n}\t{loss:.9e}\t{e:.6}\t{:e}\t{:.3}\t{}",
+                        schedule.lr(sb),
+                        prior_runtime + started.elapsed().as_secs_f64(),
+                        graph.name()
+                    )
+                    .unwrap();
+                    progress.flush().unwrap();
+                }
+            },
+            |t, sb| {
+                let runtime = prior_runtime + started.elapsed().as_secs_f64();
+                let over_cap = runtime > cap;
+                let low_disk = free_disk(&output) < min_free;
+                let averaging = schedule.average_at(sb);
+                if !(checkpoint_at(schedule, every, sb) || sb == last || averaging || over_cap || low_disk) {
+                    return;
+                }
+                let bad = nonfinite_updates();
+                assert!(bad == 0.0, "KILL: {bad} nonfinite AdamW element updates by sb {sb}");
+                let pending = output.join(format!("sb{sb:06}.pending"));
+                std::fs::create_dir(&pending).unwrap();
+                let opt = pending.join("optimiser_state");
+                std::fs::create_dir(&opt).unwrap();
+                t.optimiser.write_to_checkpoint(opt.to_str().unwrap()).unwrap();
+                st::validate_optimizer(&opt, &shapes);
+                let values = st::read_tensors(&opt.join("weights.bin"));
+                bounds(&values);
+                if averaging {
+                    match average_layout.as_deref() {
+                        None => *average_layout = Some(graph.layout().to_string()),
+                        Some(l) => assert_eq!(l, graph.layout(), "averaging layout changed inside the tail"),
+                    }
+                    average.add(sb, &values);
+                    println!("v2_average_sample\t{sb}\t{}", average.samples.len());
+                }
+                drop(values);
+                assert_eq!(average.samples, schedule.average_samples_through(sb));
+                average.save(&pending.join("average.bin"));
+                let consumed = sb * sb_records;
+                std::fs::write(
+                    pending.join("data-cursor.json"),
+                    PrefetchStream::snapshot_for(
+                        key(&cfg, "source_index"),
+                        num(&cfg, "seed") as u64,
+                        num(&cfg, "shuffle_records"),
+                        consumed as u64,
+                    )
+                    .unwrap(),
+                )
+                .unwrap();
+                let lines: Vec<String> = std::fs::read_to_string(&digest_log)
+                    .unwrap()
+                    .lines()
+                    .filter(|l| l.split('\t').next().unwrap().parse::<usize>().unwrap() <= sb)
+                    .map(str::to_string)
+                    .collect();
+                assert_eq!(lines.len(), sb, "stream digest log incomplete at checkpoint");
+                std::fs::write(pending.join("stream-digests.tsv"), lines.join("\n") + "\n").unwrap();
+                std::fs::copy(output.join("config.tsv"), pending.join("config.tsv")).unwrap();
+                let mut meta = BTreeMap::new();
+                meta.insert("schema".into(), CHECKPOINT_SCHEMA.into());
+                meta.insert("variant".into(), VARIANT.into());
+                meta.insert("config_sha256".into(), config_sha.clone());
+                meta.insert("graph".into(), graph.name().into());
+                meta.insert("layout".into(), graph.layout().into());
+                meta.insert("completed_sb".into(), sb.to_string());
+                meta.insert("completed_updates".into(), (sb * bps).to_string());
+                meta.insert("consumed_position".into(), consumed.to_string());
+                meta.insert("cumulative_runtime_seconds".into(), format!("{runtime:.3}"));
+                meta.insert("nonfinite_updates".into(), format!("{bad}"));
+                meta.insert("average_layout".into(), average_layout.clone().unwrap_or_else(|| "none".into()));
+                meta.insert(
+                    "average_samples".into(),
+                    average.samples.iter().map(usize::to_string).collect::<Vec<_>>().join(","),
+                );
+                st::write_metadata(&pending.join("state.tsv"), &meta);
+                let finalp = output.join(format!("sb{sb:06}"));
+                st::seal_and_publish(&pending, &finalp);
+                published.push(finalp.clone());
+                // Keep the newest two and the main endpoint (the finish-stage restart point).
+                let len = published.len();
+                for old in published.iter().take(len.saturating_sub(2)) {
+                    let name = old.file_name().unwrap().to_str().unwrap().to_string();
+                    if old.exists() && name != format!("sb{main_sb:06}") {
+                        std::fs::remove_dir_all(old).unwrap();
+                    }
+                }
+                println!("v2_checkpoint\t{sb}\t{consumed}\t{runtime:.1}\t{}", finalp.display());
+                assert!(!over_cap, "STOP: cumulative runtime cap {cap}s reached at sb {sb}; recoverable checkpoint written");
+                assert!(!low_disk, "STOP: free disk below {min_free} at sb {sb}; recoverable checkpoint written");
+            },
+        )
+        .unwrap();
+    assert_eq!(updates, (last + 1 - first) * bps, "early loader termination");
+}
+
+fn train(args: &BTreeMap<String, String>) {
+    let config_path = key(args, "--config").to_string();
+    let cfg = load_config(&config_path);
+    let config_sha = st::sha256(Path::new(&config_path));
+    let output = PathBuf::from(key(args, "--output"));
+    std::fs::create_dir(&output).expect("output must be new; use a new directory for every resume");
+    std::fs::copy(&config_path, output.join("config.tsv")).unwrap();
+    let started = Instant::now();
+    let bps = num(&cfg, "batches_per_sb");
+    let sb_records = BATCH * bps;
+    let schedule = st::Schedule { main: num(&cfg, "main_sb"), tail: num(&cfg, "tail_sb"), batch: BATCH, batches_per_sb: bps };
+    schedule.validate();
+    let end_sb = schedule.total();
+    let digest_log = output.join("stream-digests.tsv");
+    File::create(&digest_log).unwrap();
+
+    let mut start_sb = 1;
+    let mut prior_runtime = 0.0_f64;
+    let average = st::Average::default();
+    let mut average_layout = None;
+    let mut resume_from: Option<PathBuf> = None;
+    let mut finish_switch = false;
+    if let Some(cp) = args.get("--resume").map(PathBuf::from) {
+        st::verify_checkpoint(&cp);
+        let state = read_tsv(cp.join("state.tsv"));
+        assert_eq!(state["schema"], CHECKPOINT_SCHEMA);
+        assert_eq!(state["variant"], VARIANT);
+        assert_eq!(state["nonfinite_updates"], "0");
+        let done: usize = state["completed_sb"].parse().unwrap();
+        let old_cfg = read_tsv(cp.join("config.tsv"));
+        assert_eq!(st::sha256(&cp.join("config.tsv")), state["config_sha256"], "checkpoint config copy");
+        finish_switch = resume_config_ok(&old_cfg, &cfg, done);
+        assert!(done < end_sb, "nothing left to train");
+        assert_eq!(state["consumed_position"].parse::<usize>().unwrap(), done * sb_records);
+        let expected = PrefetchStream::snapshot_for(
+            key(&cfg, "source_index"),
+            num(&cfg, "seed") as u64,
+            num(&cfg, "shuffle_records"),
+            (done * sb_records) as u64,
+        )
+        .unwrap();
+        assert_eq!(std::fs::read_to_string(cp.join("data-cursor.json")).unwrap(), expected, "data cursor");
+        prior_runtime = state["cumulative_runtime_seconds"].parse().unwrap();
+        std::fs::copy(cp.join("stream-digests.tsv"), &digest_log).unwrap();
+        start_sb = done + 1;
+        if state["average_layout"] != "none" {
+            average_layout = Some(state["average_layout"].clone());
+        }
+        resume_from = Some(cp);
+    }
+    let stop_sb = args.get("--max-sb").map_or(end_sb, |x| x.parse().unwrap());
+    assert!(stop_sb >= start_sb && stop_sb <= end_sb);
+    let mut identity = cfg.clone();
+    identity.insert("config_sha256".into(), config_sha.clone());
+    identity.insert("runtime_binary_sha256".into(), st::sha256(&std::env::current_exe().unwrap()));
+    identity.insert("variant".into(), VARIANT.into());
+    identity.insert("start_sb".into(), start_sb.to_string());
+    identity.insert("stop_sb".into(), stop_sb.to_string());
+    identity.insert("finish_switch_at_resume".into(), finish_switch.to_string());
+    st::write_metadata(&output.join("run.tsv"), &identity);
+    let mut progress = OpenOptions::new().create_new(true).write(true).open(output.join("presentations.tsv")).unwrap();
+    writeln!(progress, "sb\tbatch\tconsumed_presentations\tloss\telapsed_seconds\tlr\tcumulative_runtime_seconds\tgraph").unwrap();
+
+    let mut run = Run {
+        cfg: cfg.clone(),
+        config_sha,
+        output: output.clone(),
+        schedule,
+        every: num(&cfg, "checkpoint_every_sb"),
+        sb_records,
+        digest_log: digest_log.clone(),
+        progress,
+        started,
+        prior_runtime,
+        average,
+        published: Vec::new(),
+        average_layout,
+    };
+
+    // Segments: one per graph (float throughout unless finish_qat=on, then float main + QAT tail).
+    let mut segments: Vec<(Graph, usize, usize)> = Vec::new();
+    let mut sb = start_sb;
+    while sb <= stop_sb {
+        let g = graph_for(&cfg, sb);
+        let mut last = sb;
+        while last < stop_sb && graph_for(&cfg, last + 1) == g {
+            last += 1;
+        }
+        segments.push((g, sb, last));
+        sb = last + 1;
+    }
+    let mut trainer: Option<Trainer> = None;
+    for (i, &(graph, first, last)) in segments.iter().enumerate() {
+        drop(trainer.take()); // free the previous graph's device memory first
+        let mut t = build(graph);
+        let shapes = model_shapes(&t);
+        let want: Vec<&str> = if graph == Graph::Float {
+            vec!["combb", "combw", "l0b", "l0w", "l1b", "l1w", "l2b", "l2w", "l3b", "l3w", "psqtb", "psqtw"]
+        } else {
+            vec!["base", "combb", "combw", "factor", "l0b", "l1b", "l1w", "l2b", "l2w", "l3b", "l3w", "pawn", "psqtb", "psqtw", "threat"]
+        };
+        assert_eq!(trainable(&t), want, "trainable tensor set (every learned tensor, as in the BT4 recipe)");
+        if i == 0 {
+            if let Some(cp) = &resume_from {
+                load_state(&mut t, cp, &shapes, graph.layout(), &output);
+                // Averaging samples exist only inside the tail, where the graph (and so the
+                // layout) is fixed; a finish switch happens at the main endpoint, before any.
+                let samples = schedule.average_samples_through(first - 1);
+                if let Some(layout) = &run.average_layout {
+                    assert!(!samples.is_empty());
+                    assert_eq!(layout, graph.layout(), "average layout differs from the resumed graph");
+                }
+                run.average = st::Average::load(&cp.join("average.bin"), &shapes, &samples);
+            } else {
+                let init_path = key(&cfg, "init").to_string();
+                let init = st::read_tensors(Path::new(&init_path));
+                assert_eq!(st::shapes(&init), shapes, "init tensor names/shapes");
+                bounds(&init);
+                drop(init);
+                t.optimiser.load_weights_from_file(&init_path).unwrap();
+                t.optimiser.reset_state().unwrap();
+                let check = output.join("loaded-init.weights.bin");
+                t.optimiser.model.write_to(&mut File::create(&check).unwrap()).unwrap();
+                assert_eq!(st::sha256(&check), key(&cfg, "init_sha256"), "init load/save roundtrip");
+                std::fs::remove_file(&check).unwrap();
+                evaluate_holdout(&mut t, &cfg, &output, "before");
+            }
+        } else {
+            // Graph switch at a segment boundary: continue from the checkpoint just written.
+            let cp = output.join(format!("sb{:06}", first - 1));
+            load_state(&mut t, &cp, &shapes, graph.layout(), &output);
+            println!("v2_graph_switch\t{}\t{}", first - 1, graph.name());
+        }
+        run_segment(&mut run, &mut t, graph, first, last);
+        trainer = Some(t);
+    }
+    let mut trainer = trainer.expect("at least one segment");
+    run.progress.sync_all().unwrap();
+    let last_graph = segments.last().unwrap().0;
+    let label = if stop_sb == end_sb { "after-raw".to_string() } else { format!("sb{stop_sb}") };
+    evaluate_holdout(&mut trainer, &cfg, &output, &label);
+    if stop_sb == end_sb {
+        let final_dir = output.join("final.pending");
+        std::fs::create_dir(&final_dir).unwrap();
+        let raw = to_layout(current_values(&trainer, &output), "float");
+        bounds(&raw);
+        st::write_tensors(&final_dir.join("raw-endpoint.weights.bin"), &raw);
+        drop(raw);
+        assert_eq!(run.average.samples, schedule.average_samples_through(end_sb));
+        let mean = to_layout(run.average.mean(), "float");
+        bounds(&mean);
+        st::write_tensors(&final_dir.join("averaged.weights.bin"), &mean);
+        drop(mean);
+        // Export the averaged masters with the float graph's save format (the standard exporter).
+        drop(trainer);
+        let mut exporter = build(Graph::Float);
+        exporter.optimiser.load_weights_from_file(final_dir.join("averaged.weights.bin").to_str().unwrap()).unwrap();
+        save::save_quantised(&exporter, final_dir.join("quantised.bin").to_str().unwrap()).unwrap();
+        evaluate_holdout(&mut exporter, &cfg, &output, "after-averaged");
+        let mut meta = identity.clone();
+        meta.insert("schema".into(), SCHEMA.into());
+        meta.insert("role".into(), "averaged.weights.bin: BT4 late-weight average (float layout); quantised.bin: its export; raw-endpoint.weights.bin: SB end".into());
+        meta.insert("completed_sb".into(), end_sb.to_string());
+        meta.insert("presentations".into(), (end_sb * sb_records).to_string());
+        meta.insert("finish_graph".into(), last_graph.name().into());
+        meta.insert("stream_digests_sha256".into(), st::sha256(&digest_log));
+        meta.insert("cumulative_runtime_seconds".into(), format!("{:.3}", run.prior_runtime + started.elapsed().as_secs_f64()));
+        meta.insert("average_samples".into(), run.average.samples.iter().map(usize::to_string).collect::<Vec<_>>().join(","));
+        st::write_metadata(&final_dir.join("state.tsv"), &meta);
+        st::seal_and_publish(&final_dir, &output.join("final"));
+    }
+    println!("v2_complete\t{VARIANT}\t{stop_sb}\t{end_sb}\t{}", stop_sb * sb_records);
+}
+
+// ---------------------------------------------------------------- export, probe, init, features, stream-scan
+
+/// CPU: per-SB logical digests of the stream (same canonical records and digest as training) for
+/// chosen superbatches, without a GPU: proves a lane index / seed / window / SB size reproduce a
+/// stream before training, and yields a `stream_reference` for the first superbatches.
+fn stream_scan(args: &BTreeMap<String, String>) {
+    let manifest = key(args, "--manifest");
+    let seed: u64 = key(args, "--seed").parse().unwrap();
+    let shuffle: usize = key(args, "--shuffle").parse().unwrap();
+    let sb_records: usize = key(args, "--sb-records").parse().unwrap();
+    let mut out = OpenOptions::new().create_new(true).write(true).open(key(args, "--out")).unwrap();
+    for sb in key(args, "--sbs").split(',').map(|x| x.parse::<usize>().unwrap()) {
+        let start = ((sb - 1) * sb_records) as u64;
+        let t = Instant::now();
+        let mut stream = PrefetchStream::open(manifest, seed, shuffle, start).unwrap();
+        assert_eq!(stream.decode_workers(), DECODE_WORKERS);
+        let mut hasher = Sha256::new();
+        let mut buffer = Vec::new();
+        let mut done = 0;
+        while done < sb_records {
+            let n = (sb_records - done).min(BATCH);
+            let rows = stream.next_batch(n).unwrap();
+            buffer.clear();
+            for row in &rows {
+                canonical(row, &mut buffer);
+            }
+            hasher.update(&buffer);
+            done += n;
+        }
+        let digest = format!("{:x}", hasher.finalize());
+        writeln!(out, "{sb}\t{start}\t{digest}").unwrap();
+        out.sync_data().unwrap();
+        println!("v2_stream_scan\t{sb}\t{start}\t{digest}\t{:.1}s", t.elapsed().as_secs_f64());
+    }
+}
+
+/// Standard exporter: the float graph and save format on float-layout masters.
+fn export(args: &BTreeMap<String, String>) {
+    let named = key(args, "--named");
+    let output = PathBuf::from(key(args, "--output"));
+    std::fs::create_dir(&output).unwrap();
+    let mut trainer = build(Graph::Float);
+    let values = st::read_tensors(Path::new(named));
+    assert_eq!(st::shapes(&values), model_shapes(&trainer), "float-layout tensor names/shapes");
+    bounds(&values);
+    trainer.optimiser.load_weights_from_file(named).unwrap();
+    save::save_quantised(&trainer, output.join("quantised.bin").to_str().unwrap()).unwrap();
+    println!("v2_export\t{}\t{}", st::sha256(Path::new(named)), st::sha256(&output.join("quantised.bin")));
+}
+
+/// Forward raw outputs on FEN rows. graph=float: [output] per row (float masters).
+/// graph=qat: B1's probe layout per row (split masters from float ones by exact split).
+fn probe(args: &BTreeMap<String, String>) {
+    let output = PathBuf::from(key(args, "--output"));
+    std::fs::create_dir(&output).unwrap();
+    let named = key(args, "--named");
+    let qat = match key(args, "--graph") {
+        "float" => false,
+        "qat" => true,
+        g => panic!("graph {g}"),
+    };
+    let fens = std::fs::read_to_string(key(args, "--fens")).unwrap();
+    let rows: Vec<bulletformat::ChessBoard> =
+        fens.lines().map(|f| format!("{f} | 0 | 0.5").parse::<bulletformat::ChessBoard>().unwrap()).collect();
+    let mut trainer = if qat { split_trainer(true, true) } else { float_trainer(false) };
+    let values = to_layout(st::read_tensors(Path::new(named)), if qat { "split" } else { "float" });
+    assert_eq!(st::shapes(&values), model_shapes(&trainer));
+    bounds(&values);
+    let file = output.join("masters.weights.bin");
+    st::write_tensors(&file, &values);
+    trainer.optimiser.load_weights_from_file(file.to_str().unwrap()).unwrap();
+    std::fs::remove_file(&file).unwrap();
+    let width = if qat { 2 * FT + FT + NB * L2 + L2 + L3 + 1 + 1 } else { 1 };
+    let mut out = OpenOptions::new().create_new(true).write(true).open(output.join("outputs.f32le")).unwrap();
+    for chunk in rows.chunks(4096) {
+        let host = trainer.state.prepare(chunk, 4, 0.1, TARGET_DIVISOR);
+        let raw = forward_host(&mut trainer, host, chunk.len());
+        assert_eq!(raw.len(), chunk.len() * width);
+        let b: Vec<u8> = raw.iter().flat_map(|x| x.to_le_bytes()).collect();
+        out.write_all(&b).unwrap();
+    }
+    println!("v2_probe\trows={}\tgraph={}\twidth={width}\tnamed={}", rows.len(), key(args, "--graph"), st::sha256(Path::new(named)));
+}
+
+/// zq_bt4_full.rs seed PSQT material on the HalfKA block (VERBATIM arithmetic, 16 buckets);
+/// factoriser, threat and pawn PSQT start at zero.
+fn psqt_material_init() -> Vec<f32> {
+    let mut w = vec![0.0f32; ROWS];
+    for h in 0..HALFKA {
+        let within = h % 768;
+        let own = within < 384;
+        let pt = (within % 384) / 64;
+        let val = if pt == 5 { 0.0 } else { PIECE_VALUE_CP[pt] / 400.0 };
+        w[FAC + h] = if own { val } else { -val };
+    }
+    w
+}
+
+/// Fresh initialisation with the zq_bt4_full.rs procedure (l0 normal with effective input size
+/// 192 over all rows, bullet defaults elsewhere, PSQT material seed, combiner [1,1]/0), plus the
+/// v2 invariant: the 210 dead PP1 rows (never active) and their PSQT entries are exactly zero.
+fn init(args: &BTreeMap<String, String>) {
+    let seed: u64 = key(args, "--seed").parse().unwrap();
+    let output = PathBuf::from(key(args, "--output"));
+    std::fs::create_dir(&output).unwrap();
+    INIT_SEED.set(seed).unwrap();
+    let mut trainer = float_trainer(false);
+    assert!(trainer.optimiser.model.set_weights("psqtw", &TValue::F32(psqt_material_init())));
+    let _ = trainer.optimiser.model.set_weights("combw", &TValue::F32(vec![1.0, 1.0]));
+    let _ = trainer.optimiser.model.set_weights("combb", &TValue::F32(vec![0.0]));
+    let drawn = output.join("drawn.weights.bin");
+    trainer.optimiser.model.write_to(&mut File::create(&drawn).unwrap()).unwrap();
+    let mut values = st::read_tensors(&drawn);
+    let l0w = values.get_mut("l0w").unwrap();
+    let mut zeroed = 0usize;
+    for p in (0..PAWN).filter(|&p| is_dead_pawn_row(p)) {
+        for x in &mut l0w[(PAWN0 + p) * FT..(PAWN0 + p + 1) * FT] {
+            *x = 0.0;
+        }
+        zeroed += 1;
+    }
+    assert_eq!(zeroed, 210, "PP1 dead rows");
+    let path = output.join("initial.weights.bin");
+    st::write_tensors(&path, &values);
+    bounds(&values);
+    trainer.optimiser.load_weights_from_file(path.to_str().unwrap()).unwrap();
+    let check = output.join("loaded.weights.bin");
+    trainer.optimiser.model.write_to(&mut File::create(&check).unwrap()).unwrap();
+    assert_eq!(st::sha256(&check), st::sha256(&path), "init load/save roundtrip");
+    std::fs::remove_file(&check).unwrap();
+    save::save_quantised(&trainer, output.join("quantised.bin").to_str().unwrap()).unwrap();
+    println!("v2_init\t{VARIANT}\t{seed}\t{}\t{}", st::sha256(&path), st::sha256(&drawn));
+}
+
+/// Trainer-side sparse features per FEN row (row, material bucket, 0, stm list, ntm list) in the
+/// combined index space (factoriser < 768, HalfKA at 768.., threats at 768+12288.., PP1 rows at
+/// 768+12288+60144+p): the input of the exact CPU reference for export/loader parity.
+fn features(args: &BTreeMap<String, String>) {
+    use bullet_lib::game::outputs::OutputBuckets;
+    let fens = std::fs::read_to_string(key(args, "--fens")).unwrap();
+    let feats = inputs();
+    let mut f = std::io::BufWriter::new(OpenOptions::new().create_new(true).write(true).open(key(args, "--out")).unwrap());
+    writeln!(f, "row\tbucket\tpsqt_exact_bits\tstm\tntm").unwrap();
+    for (i, fen) in fens.lines().enumerate() {
+        let row = format!("{fen} | 0 | 0.5").parse::<bulletformat::ChessBoard>().unwrap();
+        let (mut a, mut b) = (Vec::new(), Vec::new());
+        feats.map_features(&row, |s, n| {
+            a.push(s.to_string());
+            b.push(n.to_string());
+        });
+        let bucket = MaterialCount::<NB>::default().bucket(&row);
+        writeln!(f, "{i}\t{bucket}\t0\t{}\t{}", a.join(","), b.join(",")).unwrap();
+    }
+    f.flush().unwrap();
+    println!("v2_features\t{VARIANT}\t{}", fens.lines().count());
+}
+
+fn main() {
+    let mut argv = std::env::args().skip(1);
+    let mode = argv.next().expect("mode");
+    let mut args = BTreeMap::new();
+    while let Some(k) = argv.next() {
+        assert!(k.starts_with("--"), "bad argument {k}");
+        assert!(args.insert(k, argv.next().expect("missing value")).is_none(), "duplicate argument");
+    }
+    match mode.as_str() {
+        "train" => train(&args),
+        "export" => export(&args),
+        "probe" => probe(&args),
+        "init" => init(&args),
+        "features" => features(&args),
+        "stream-scan" => stream_scan(&args),
+        "constants" => {
+            println!("variant\t{VARIANT}\nrows\t{ROWS}\ndeployed\t{DEPLOYED}\nhalfka\t{HALFKA}\npawn0\t{PAWN0}");
+            println!("bucket_layout\t{}", BUCKET_LAYOUT.iter().map(usize::to_string).collect::<Vec<_>>().join(","));
+            println!("max_active\t{}", inputs().max_active());
+        }
+        _ => panic!("unknown mode {mode}"),
+    }
+}
