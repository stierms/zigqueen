+        let paths: Vec<_> = (0..2).map(|i| p.0.join(format!("{i}.binpack")).to_str().unwrap().to_string()).collect();
+        let refs: Vec<_> = paths.iter().map(String::as_str).collect();
+        let mut loader = SfBinpackLoader::new_concat_multiple(&refs, 1, threads, |e| {
+            // Deliberately skew completion order without changing acceptance.
+            if e.score % 128 == 0 {
