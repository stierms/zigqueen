@@ -0,0 +1,297 @@
+#!/usr/bin/env python3
+"""
+fullthreats_grader.py — SOURCE-OF-TRUTH feature enumerator for the v6
+60,144-feature full-threats space (project zigqueen).
+
+Implements docs/V6_THREATS_SPEC.md (spec r2, FROZEN 2026-08-07) exactly:
+  space   : (attacker colored-type, from-sq, victim colored-type, to-sq),
+            attackers PNBRQ, king victims removed, subset combos removed
+            (p->b, p->q, b->q, r->q), empty-board attack-set restricted.
+  index   : idx = AK_OFFSET[ak] + (PAIR_BASE[ak][f] + pairpos) * (2*nv) + v
+            (iteration order: ak, oriented from, oriented to, victim class)
+  orient  : sq (white persp) / sq^56 (black persp), then ^7 iff own king
+            on files e-h. Own pawns attack north in the oriented frame.
+  spec r2 : NO activation dedup — both directions of mutual same-type
+            pairs activate (a per-perspective square-order rule would break
+            the trainer's paired stm/ntm emission).
+
+This grader is the bit-exactness reference for: the Zig engine enumerator,
+the bullet map_features implementation, and the NumPy full-forward
+reference. Usage:
+  fullthreats_grader.py --self-test
+  fullthreats_grader.py --fen "<FEN>"            (prints both persp sets)
+  fullthreats_grader.py --zig-vector "<FEN>"     (emits a Zig test case)
+Needs: python-chess.
+"""
+
+import argparse
+import sys
+
+try:
+    import chess
+except ImportError:
+    sys.exit("FATAL: python-chess not importable.")
+
+PAWN, KNIGHT, BISHOP, ROOK, QUEEN = 0, 1, 2, 3, 4
+TYPE_NAMES = "PNBRQ"
+
+# Victim kept-sets per attacker type (spec r1). Ordered P<N<B<R<Q.
+KEPT = {
+    PAWN:   [PAWN, KNIGHT, ROOK],
+    KNIGHT: [PAWN, KNIGHT, BISHOP, ROOK, QUEEN],
+    BISHOP: [PAWN, KNIGHT, BISHOP, ROOK],
+    ROOK:   [PAWN, KNIGHT, BISHOP, ROOK],
+    QUEEN:  [PAWN, KNIGHT, BISHOP, ROOK, QUEEN],
+}
+NV = {t: len(s) for t, s in KEPT.items()}
+VRANK = {t: {v: i for i, v in enumerate(s)} for t, s in KEPT.items()}
+
+_PT = {chess.PAWN: PAWN, chess.KNIGHT: KNIGHT, chess.BISHOP: BISHOP,
+       chess.ROOK: ROOK, chess.QUEEN: QUEEN}
+
+
+def _empty_attacks(atype, own, f):
+    """Empty-board attack bitboard of (type, own/opp pawn direction) from
+    oriented square f. own=True => pawn attacks north (oriented frame)."""
+    if atype == PAWN:
+        r, c = divmod(f, 8)
+        bb = 0
+        if own:
+            if r >= 8 - 1:  # pawns never on rank 8; guard anyway
+                return 0
+            if r > 6:
+                return 0
+            if c > 0:
+                bb |= 1 << (f + 7)
+            if c < 7:
+                bb |= 1 << (f + 9)
+        else:
+            if r < 1:
+                return 0
+            if c > 0:
+                bb |= 1 << (f - 9)
+            if c < 7:
+                bb |= 1 << (f - 7)
+        return bb
+    b = chess.Board.empty()
+    piece = {KNIGHT: chess.KNIGHT, BISHOP: chess.BISHOP,
+             ROOK: chess.ROOK, QUEEN: chess.QUEEN}[atype]
+    b.set_piece_at(f, chess.Piece(piece, chess.WHITE))
+    return int(b.attacks(f))
+
+
+def _pawn_from_ok(atype, f):
+    """Pawns only exist on ranks 2..7 (oriented)."""
+    if atype != PAWN:
+        return True
+    return 8 <= f <= 55
+
+
+# ----------------------------------------------------------------------------
+# Frozen tables: AK_OFFSET[ak], PAIR_BASE[ak][f], attack sets per (ak, f).
+# ak = (0 own / 5 opp) + type; "own" decides pawn direction only.
+# ----------------------------------------------------------------------------
+AK_OFFSET = [0] * 10
+PAIR_BASE = [[0] * 64 for _ in range(10)]
+EMPTY_ATT = [[0] * 64 for _ in range(10)]
+
+_off = 0
+for ak in range(10):
+    own = ak < 5
+    atype = ak % 5
+    AK_OFFSET[ak] = _off
+    pairs = 0
+    for f in range(64):
+        PAIR_BASE[ak][f] = pairs
+        if not _pawn_from_ok(atype, f):
+            continue
+        att = _empty_attacks(atype, own, f)
+        EMPTY_ATT[ak][f] = att
+        pairs += bin(att).count("1")
+    _off += pairs * 2 * NV[atype]
+TOTAL_FEATURES = _off
+
+
+def orient(sq, persp_white, flip):
+    o = sq if persp_white else sq ^ 56
+    return o ^ (7 if flip else 0)
+
+
+def feature_index(ak, f_o, t_o, victim_own, vtype):
+    atype = ak % 5
+    att = EMPTY_ATT[ak][f_o]
+    assert (att >> t_o) & 1, "target not in empty-board attack set"
+    pairpos = bin(att & ((1 << t_o) - 1)).count("1")
+    nv = NV[atype]
+    v = (0 if victim_own else nv) + VRANK[atype][vtype]
+    return AK_OFFSET[ak] + (PAIR_BASE[ak][f_o] + pairpos) * (2 * nv) + v
+
+
+def enumerate_features(board, persp_white):
+    """Active feature indices (sorted list) for one perspective."""
+    ksq = board.king(chess.WHITE if persp_white else chess.BLACK)
+    k_o = ksq if persp_white else ksq ^ 56
+    flip = (k_o & 7) > 3
+    feats = set()
+    for a_sq in chess.SQUARES:
+        ap = board.piece_at(a_sq)
+        if ap is None or ap.piece_type == chess.KING:
+            continue
+        atype = _PT[ap.piece_type]
+        a_own = (ap.color == chess.WHITE) == persp_white
+        ak = (0 if a_own else 5) + atype
+        attacked = board.attacks(a_sq)
+        for t_sq in attacked:
+            vp = board.piece_at(t_sq)
+            if vp is None or vp.piece_type == chess.KING:
+                continue
+            vtype = _PT[vp.piece_type]
+            if vtype not in VRANK[atype]:
+                continue
+            f_o = orient(a_sq, persp_white, flip)
+            t_o = orient(t_sq, persp_white, flip)
+            v_own = (vp.color == chess.WHITE) == persp_white
+            feats.add(feature_index(ak, f_o, t_o, v_own, vtype))
+    return sorted(feats)
+
+
+# ----------------------------------------------------------------------------
+def self_test():
+    ok = True
+
+    # 1. Table arithmetic vs the derivation in the spec.
+    per_color = 84 * 6 + 336 * 10 + 560 * 8 + 896 * 8 + 1456 * 10
+    assert per_color == 30072, per_color
+    assert TOTAL_FEATURES == 60144, TOTAL_FEATURES
+    assert AK_OFFSET[5] == 30072, AK_OFFSET
+    pair_counts = {PAWN: 84, KNIGHT: 336, BISHOP: 560, ROOK: 896, QUEEN: 1456}
+    for ak in range(10):
+        atype = ak % 5
+        n = sum(bin(EMPTY_ATT[ak][f]).count("1") for f in range(64))
+        assert n == pair_counts[atype], (ak, n)
+    print(f"[ok] table arithmetic: total {TOTAL_FEATURES}, per-color {per_color}")
+
+    # 2. Startpos symmetry: white/black perspectives must be identical.
+    b = chess.Board()
+    fw, fb = enumerate_features(b, True), enumerate_features(b, False)
+    if fw != fb:
+        print("[FAIL] startpos perspective symmetry"); ok = False
+    else:
+        print(f"[ok] startpos symmetric, {len(fw)} active features/persp")
+
+    # 3. Horizontal-mirror invariance: mirroring the board (files) must give
+    #    identical feature sets (flip rule compensates).
+    fen_asym = "r1bqk2r/pppp1ppp/2n2n2/2b1p3/2B1P3/2N2N2/PPPP1PPP/R1BQK2R w KQkq - 4 5"
+    b1 = chess.Board(fen_asym)
+    b2 = b1.transform(chess.flip_horizontal)
+    if enumerate_features(b1, True) != enumerate_features(b2, True):
+        print("[FAIL] horizontal-mirror invariance (white persp)"); ok = False
+    else:
+        print("[ok] horizontal-mirror invariance")
+
+    # 4. Color-mirror: flipping colors+board swaps perspectives exactly.
+    b3 = b1.mirror()
+    if enumerate_features(b1, True) != enumerate_features(b3, False):
+        print("[FAIL] color-mirror perspective swap"); ok = False
+    else:
+        print("[ok] color-mirror perspective swap")
+
+    # 5. Mutual same-type pairs: BOTH directions activate (spec r2 — no
+    #    activation dedup; trainer stm/ntm pairing requires it).
+    b4 = chess.Board.empty()
+    b4.set_piece_at(chess.E4, chess.Piece(chess.KNIGHT, chess.WHITE))
+    b4.set_piece_at(chess.D6, chess.Piece(chess.KNIGHT, chess.BLACK))
+    b4.set_piece_at(chess.A1, chess.Piece(chess.KING, chess.WHITE))
+    b4.set_piece_at(chess.H8, chess.Piece(chess.KING, chess.BLACK))
+    f4 = enumerate_features(b4, True)
+    if len(f4) != 2:
+        print(f"[FAIL] mutual pair: expected 2 features, got {len(f4)}"); ok = False
+    else:
+        print("[ok] mutual same-type pair: both directions active (spec r2)")
+
+    # 6. Pawn pair: mutual-exempt — white P attacks black p AND black p
+    #    attacks white P are DIFFERENT squares geometry; construct a defend
+    #    chain to check pawns keep both a->b and b->a when both real.
+    b5 = chess.Board.empty()
+    b5.set_piece_at(chess.E4, chess.Piece(chess.PAWN, chess.WHITE))
+    b5.set_piece_at(chess.D5, chess.Piece(chess.PAWN, chess.BLACK))
+    b5.set_piece_at(chess.A1, chess.Piece(chess.KING, chess.WHITE))
+    b5.set_piece_at(chess.H8, chess.Piece(chess.KING, chess.BLACK))
+    f5 = enumerate_features(b5, True)
+    if len(f5) != 2:
+        print(f"[FAIL] pawn mutual attacks: expected 2, got {len(f5)}"); ok = False
+    else:
+        print("[ok] pawn pairs exempt from R1 (both directions active)")
+
+    # 7. Kept-set filtering: a rook attacking a queen must emit nothing.
+    b6 = chess.Board.empty()
+    b6.set_piece_at(chess.A4, chess.Piece(chess.ROOK, chess.WHITE))
+    b6.set_piece_at(chess.H4, chess.Piece(chess.QUEEN, chess.BLACK))
+    b6.set_piece_at(chess.A1, chess.Piece(chess.KING, chess.WHITE))
+    b6.set_piece_at(chess.H8, chess.Piece(chess.KING, chess.BLACK))
+    f6 = enumerate_features(b6, True)
+    # queen DOES attack rook back (q->r kept): exactly 1 feature.
+    if len(f6) != 1:
+        print(f"[FAIL] kept-set filter: expected 1 (q->r only), got {len(f6)}"); ok = False
+    else:
+        print("[ok] kept-set filtering (r->q suppressed, q->r active)")
+
+    # 8. Occupancy blocking: interposed piece kills the slider attack.
+    b7 = chess.Board.empty()
+    b7.set_piece_at(chess.A4, chess.Piece(chess.ROOK, chess.WHITE))
+    b7.set_piece_at(chess.D4, chess.Piece(chess.KNIGHT, chess.WHITE))
+    b7.set_piece_at(chess.H4, chess.Piece(chess.ROOK, chess.BLACK))
+    b7.set_piece_at(chess.A1, chess.Piece(chess.KING, chess.WHITE))
+    b7.set_piece_at(chess.H8, chess.Piece(chess.KING, chess.BLACK))
+    f7 = enumerate_features(b7, True)
+    # active: wRa4->wNd4 (defend), bRh4->wNd4 (attack). wR<->bR blocked.
+    if len(f7) != 2:
+        print(f"[FAIL] occupancy blocking: expected 2, got {len(f7)}"); ok = False
+    else:
+        print("[ok] occupancy blocking (interposition suppresses R<->R)")
+
+    # 9. Index-space bounds + injectivity across a batch of positions.
+    fens = [
+        chess.STARTING_FEN,
+        "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
+        "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
+        "r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10",
+        "rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8",
+    ]
+    for fen in fens:
+        bx = chess.Board(fen)
+        for persp in (True, False):
+            fs = enumerate_features(bx, persp)
+            if fs and (fs[0] < 0 or fs[-1] >= TOTAL_FEATURES):
+                print(f"[FAIL] bounds: {fen}"); ok = False
+    print("[ok] bounds over 5 positions x 2 perspectives")
+
+    print("SELF-TEST", "PASS" if ok else "FAIL")
+    return 0 if ok else 1
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--self-test", action="store_true")
+    ap.add_argument("--fen")
+    ap.add_argument("--zig-vector")
+    args = ap.parse_args()
+    if args.self_test:
+        sys.exit(self_test())
+    fen = args.fen or args.zig_vector
+    if not fen:
+        ap.print_help(); sys.exit(2)
+    b = chess.Board(fen)
+    fw = enumerate_features(b, True)
+    fb = enumerate_features(b, False)
+    if args.zig_vector:
+        print(f"// grader vector (spec r2): {fen}")
+        print(f"// white persp ({len(fw)}): {fw}")
+        print(f"// black persp ({len(fb)}): {fb}")
+    else:
+        print(f"white persp ({len(fw)}): {fw}")
+        print(f"black persp ({len(fb)}): {fb}")
+
+
+if __name__ == "__main__":
+    main()
