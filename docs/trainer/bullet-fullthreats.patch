+pub trait AuxInput<T>: Send + Sync {
+    fn aux_num_inputs(&self) -> usize;
+    fn aux_max_active(&self) -> usize;
+    fn aux_map_features(&self, pos: &T, f: &mut dyn FnMut(usize, usize));
