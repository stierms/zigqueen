+static PSQT: std::sync::OnceLock<Vec<i64>> = std::sync::OnceLock::new();
+type OwnInputs = Combined<Factorised<ChessBucketsMirrored, Chess768>, FullThreatInputs60k>;
+static PSQT_INPUTS: std::sync::OnceLock<OwnInputs> = std::sync::OnceLock::new();
+fn exact_psqt(pos: &bulletformat::ChessBoard) -> f32 {
+    use bullet_lib::game::inputs::SparseInputType;
+    let psqt = PSQT.get().unwrap();
+    let mut sum = psqt[DEPLOYED];
+    let inputs = PSQT_INPUTS.get_or_init(|| {
+        Combined::new(
+            Factorised::from_parts(ChessBucketsMirrored::new(BUCKET_LAYOUT), Chess768),
+            FullThreatInputs60k::new(),
+        )
+    });
+    inputs.map_features(pos, |stm, _| {
+        if stm >= FAC {
+            sum += psqt[stm - FAC];
+        }
+    });
+    (sum as f64 / 1048576.0) as f32
+}
