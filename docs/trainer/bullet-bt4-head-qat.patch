+    fn fixture() -> Fixture {
+        static ID: AtomicUsize = AtomicUsize::new(0);
+        let p = std::env::temp_dir().join(format!(
+            "zq-loader-{}-{}",
+            std::process::id(),
+            ID.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir(&p).unwrap();
+        for file in 0..2 {
+            let mut writer =
+                CompressedTrainingDataEntryWriter::new(File::create(p.join(format!("{file}.binpack"))).unwrap())
