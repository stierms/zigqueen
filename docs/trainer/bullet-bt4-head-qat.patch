diff --git a/crates/bullet_lib/src/game/inputs/combined.rs b/crates/bullet_lib/src/game/inputs/combined.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2224f1f3ab22d7cd36f09575a87ca6e86c6278e5
--- /dev/null
+++ b/crates/bullet_lib/src/game/inputs/combined.rs
@@ -0,0 +1,53 @@
+//! Generic concatenation of two INDEPENDENT sparse input sets into ONE index space, so a
+//! SINGLE feature transformer (one affine) sees both. This is the bullet-supported way to
+//! express ADDITIVE fusion of two feature sets: one affine over `[A | B]` produces the
+//! accumulator `W_A·A + W_B·B` — a single shared accumulator with no separate columns for a
+//! readout to rob — identical to summing two FT outputs, but WITHOUT the unsupported
+//! add-of-activations (`CopyOp` in the backward). B's indices are offset past A's input count.
+//! At save, split the FT weight columns back into the A-block and B-block for the engine.
+//!
+//! NB this is NOT `Factorised`: there the second set must be *derived from* the first
+//! (`derive_feature`) and is merged away at save. Here A and B are independent and both persist.
+use super::SparseInputType;
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Combined<A, B> {
+    a: A,
+    b: B,
+}
+
+impl<A, B> Combined<A, B> {
+    pub fn new(a: A, b: B) -> Self {
+        Self { a, b }
+    }
+}
+
+impl<A, B> SparseInputType for Combined<A, B>
+where
+    A: SparseInputType,
+    B: SparseInputType<RequiredDataType = A::RequiredDataType>,
+{
+    type RequiredDataType = A::RequiredDataType;
+
+    fn num_inputs(&self) -> usize {
+        self.a.num_inputs() + self.b.num_inputs()
+    }
+
+    fn max_active(&self) -> usize {
+        self.a.max_active() + self.b.max_active()
+    }
+
+    fn map_features<F: FnMut(usize, usize)>(&self, pos: &Self::RequiredDataType, mut f: F) {
+        let offset = self.a.num_inputs();
+        self.a.map_features(pos, |s, n| f(s, n));
+        self.b.map_features(pos, |s, n| f(offset + s, offset + n));
+    }
+
+    fn shorthand(&self) -> String {
+        format!("{}+{}", self.a.shorthand(), self.b.shorthand())
+    }
+
+    fn description(&self) -> String {
+        format!("{} | combined with | {}", self.a.description(), self.b.description())
+    }
+}
diff --git a/crates/bullet_lib/src/game/inputs/halfka_threats.rs b/crates/bullet_lib/src/game/inputs/halfka_threats.rs
new file mode 100644
index 0000000000000000000000000000000000000000..feed98b11f35d75fe06b2c6c2291444e994fbd91
--- /dev/null
+++ b/crates/bullet_lib/src/game/inputs/halfka_threats.rs
@@ -0,0 +1,671 @@
+//! SFNNv10-style FULL THREAT inputs as a **standalone** sparse feature set with **local**
+//! indices `[0, num_inputs())`, to be used as an AUXILIARY input alongside HalfKA — each
+//! drives its OWN feature transformer, so the threat FT can be narrow (its weight matrix is
+//! `num_inputs() x FT_threats`, not `... x FT_halfka`).
+//!
+//! A threat feature encodes an attack relation **(attacker piece, from) -> (attacked piece,
+//! to)** for every piece on the board (both colours) and every OCCUPIED square in that
+//! piece's attack set (enemy = attack, own = defend; both count). Kings are not threat
+//! *sources* (matches SF's numValidTargets[king]=0) but can be threat *targets*.
+//!
+//! Orientation is identical to HalfKA so the two compose cleanly:
+//!   - stm perspective: square `s`, file-mirrored `^7` iff our king file > 3.
+//!   - ntm perspective: square `s^56` (vertical flip + colour swap), file-mirrored `^7` iff
+//!     opp king file > 3.
+//! Piece colour is perspective-relative (own=0, opp=1); for ntm the colours swap.
+//!
+//! ## Index layout (THIS is the spec the zigqueen engine must replicate bit-for-bit)
+//!   threat_index = base_pairs(attacker_key, from_o) ... compact over geometrically-valid
+//!   (attacker_key, from, to) triples ... then * 12 + attacked_rel.
+//!   - attacker_key in [0,10): {own,opp} x {pawn,knight,bishop,rook,queen}
+//!   - attacked_rel in [0,12): {own,opp} x {pawn,knight,bishop,rook,queen,king}
+//!   - only `to` squares reachable by the attacker's max attack pattern from `from` exist.
+//! The attack *set* at runtime is occupancy-dependent (sliders), but the INDEX SPACE spans
+//! every geometrically-reachable (from,to) so the index is occupancy-independent.
+
+use bulletformat::ChessBoard;
+
+use super::SparseInputType;
+
+// piece types as stored in bulletformat (piece & 7)
+const PAWN: usize = 0;
+const KNIGHT: usize = 1;
+const BISHOP: usize = 2;
+const ROOK: usize = 3;
+const QUEEN: usize = 4;
+const KING: usize = 5;
+
+const NUM_ATTACKER_KEYS: usize = 10; // {own,opp} x {P,N,B,R,Q}
+const NUM_ATTACKED_REL: usize = 12; // {own,opp} x {P,N,B,R,Q,K}
+
+#[inline]
+fn file(sq: usize) -> usize {
+    sq & 7
+}
+#[inline]
+fn rank(sq: usize) -> usize {
+    sq >> 3
+}
+
+/// Max attack pattern (empty-board for leapers; full rays for sliders) of a non-pawn type
+/// from `sq`, as a list of destination squares. Pawns handled separately (colour-specific).
+fn max_pattern(pt: usize, sq: usize) -> Vec<usize> {
+    let r = rank(sq) as i32;
+    let f = file(sq) as i32;
+    let mut out = Vec::new();
+    let mut add = |nr: i32, nf: i32| {
+        if (0..8).contains(&nr) && (0..8).contains(&nf) {
+            out.push((nr * 8 + nf) as usize);
+        }
+    };
+    match pt {
+        KNIGHT => {
+            for (dr, df) in [(1, 2), (2, 1), (2, -1), (1, -2), (-1, -2), (-2, -1), (-2, 1), (-1, 2)] {
+                add(r + dr, f + df);
+            }
+        }
+        KING => {
+            for dr in -1..=1 {
+                for df in -1..=1 {
+                    if dr != 0 || df != 0 {
+                        add(r + dr, f + df);
+                    }
+                }
+            }
+        }
+        BISHOP | ROOK | QUEEN => {
+            let mut dirs: Vec<(i32, i32)> = Vec::new();
+            if pt != ROOK {
+                dirs.extend_from_slice(&[(1, 1), (1, -1), (-1, 1), (-1, -1)]);
+            }
+            if pt != BISHOP {
+                dirs.extend_from_slice(&[(1, 0), (-1, 0), (0, 1), (0, -1)]);
+            }
+            for (dr, df) in dirs {
+                let (mut nr, mut nf) = (r + dr, f + df);
+                while (0..8).contains(&nr) && (0..8).contains(&nf) {
+                    out.push((nr * 8 + nf) as usize);
+                    nr += dr;
+                    nf += df;
+                }
+            }
+        }
+        _ => unreachable!("max_pattern: bad piece type"),
+    }
+    out
+}
+
+/// Pawn capture destinations from `sq` for a pawn that advances toward higher ranks if
+/// `up`, else lower ranks. Empty on the rank where it can't exist.
+fn pawn_pattern(sq: usize, up: bool) -> Vec<usize> {
+    let r = rank(sq) as i32;
+    let f = file(sq) as i32;
+    let dr = if up { 1 } else { -1 };
+    let mut out = Vec::new();
+    for df in [-1, 1] {
+        let (nr, nf) = (r + dr, f + df);
+        if (0..8).contains(&nr) && (0..8).contains(&nf) {
+            out.push((nr * 8 + nf) as usize);
+        }
+    }
+    out
+}
+
+/// attacker_key in [0,10): own={P,N,B,R,Q} -> 0..5, opp -> 5..10.
+fn attacker_pattern(key: usize, sq: usize) -> Vec<usize> {
+    let own = key < 5;
+    let pt = key % 5; // 0=P,1=N,2=B,3=R,4=Q
+    match pt {
+        0 => pawn_pattern(sq, own), // own pawns advance up (stm at bottom), opp down
+        1 => max_pattern(KNIGHT, sq),
+        2 => max_pattern(BISHOP, sq),
+        3 => max_pattern(ROOK, sq),
+        4 => max_pattern(QUEEN, sq),
+        _ => unreachable!(),
+    }
+}
+
+/// Precomputed compact index over geometrically-valid (attacker_key, from, to) triples.
+#[derive(Clone, Debug)]
+struct ThreatIndex {
+    base: Vec<usize>,      // [attacker_key*64 + from] -> cumulative pair offset
+    local: Vec<[u16; 64]>, // [attacker_key*64 + from][to] -> local idx (or u16::MAX)
+    num_pairs: usize,
+}
+
+const NO_LOCAL: u16 = u16::MAX;
+
+impl ThreatIndex {
+    fn new() -> Self {
+        let mut base = vec![0usize; NUM_ATTACKER_KEYS * 64];
+        let mut local = vec![[NO_LOCAL; 64]; NUM_ATTACKER_KEYS * 64];
+        let mut running = 0usize;
+        for key in 0..NUM_ATTACKER_KEYS {
+            for from in 0..64 {
+                let slot = key * 64 + from;
+                base[slot] = running;
+                for (i, to) in attacker_pattern(key, from).into_iter().enumerate() {
+                    local[slot][to] = i as u16;
+                    running += 1;
+                }
+            }
+        }
+        Self { base, local, num_pairs: running }
+    }
+
+    #[inline]
+    fn index(&self, attacker_key: usize, from_o: usize, to_o: usize, attacked_rel: usize) -> Option<usize> {
+        let slot = attacker_key * 64 + from_o;
+        let l = self.local[slot][to_o];
+        if l == NO_LOCAL {
+            return None;
+        }
+        Some((self.base[slot] + l as usize) * NUM_ATTACKED_REL + attacked_rel)
+    }
+
+    #[inline]
+    fn num_features(&self) -> usize {
+        self.num_pairs * NUM_ATTACKED_REL
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct ThreatInputs {
+    threats: ThreatIndex,
+}
+
+impl Default for ThreatInputs {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl ThreatInputs {
+    pub fn new() -> Self {
+        Self { threats: ThreatIndex::new() }
+    }
+}
+
+impl SparseInputType for ThreatInputs {
+    type RequiredDataType = ChessBoard;
+
+    fn num_inputs(&self) -> usize {
+        self.threats.num_features()
+    }
+
+    fn max_active(&self) -> usize {
+        128 // SF MaxActiveDimensions for full threats
+    }
+
+    fn map_features<F: FnMut(usize, usize)>(&self, pos: &Self::RequiredDataType, mut f: F) {
+        let mut occ: u64 = 0;
+        let mut squares: Vec<(usize, usize)> = Vec::with_capacity(32); // (piece, square)
+        for (piece, square) in pos.into_iter() {
+            occ |= 1u64 << square;
+            squares.push((usize::from(piece), usize::from(square)));
+        }
+        let piece_at = |sq: usize, sqs: &[(usize, usize)]| -> Option<usize> {
+            sqs.iter().find(|&&(_, s)| s == sq).map(|&(p, _)| p)
+        };
+
+        let our_k = usize::from(pos.our_ksq());
+        let opp_k = usize::from(pos.opp_ksq());
+        let stm_flip = if file(our_k) > 3 { 7 } else { 0 };
+        let ntm_flip = if file(opp_k) > 3 { 7 } else { 0 };
+
+        for &(piece, from) in &squares {
+            let colour = (piece >> 3) & 1; // 0 = stm side (own), 1 = ntm side (opp)
+            let pt = piece & 7;
+            if pt == KING {
+                continue; // king is not a threat source
+            }
+            let attacks = match pt {
+                PAWN => pawn_attacks(from, colour == 0),
+                KNIGHT => knight_attacks(from),
+                KING => 0,
+                _ => slider_attacks(pt, from, occ),
+            } & occ; // only occupied targets
+
+            let mut bb = attacks;
+            while bb != 0 {
+                let to = bb.trailing_zeros() as usize;
+                bb &= bb - 1;
+                let tpiece = match piece_at(to, &squares) {
+                    Some(p) => p,
+                    None => continue,
+                };
+                let tcolour = (tpiece >> 3) & 1;
+                let tpt = tpiece & 7;
+
+                // stm: attacker colour as-is, squares file-mirrored.
+                let stm_idx =
+                    self.threats.index(colour * 5 + pt, from ^ stm_flip, to ^ stm_flip, tcolour * 6 + tpt);
+                // ntm: colours swap, squares vertical-flip ^56 then file-mirror.
+                let ntm_idx = self.threats.index(
+                    (colour ^ 1) * 5 + pt,
+                    (from ^ 56) ^ ntm_flip,
+                    (to ^ 56) ^ ntm_flip,
+                    (tcolour ^ 1) * 6 + tpt,
+                );
+
+                if let (Some(s), Some(n)) = (stm_idx, ntm_idx) {
+                    f(s, n);
+                }
+            }
+        }
+    }
+
+    fn shorthand(&self) -> String {
+        format!("threats{}", self.threats.num_features())
+    }
+
+    fn description(&self) -> String {
+        "SFNNv10-style full threat inputs (standalone auxiliary feature set)".to_string()
+    }
+}
+
+/// LEAN threat inputs: the SAME SFNNv10 attack enumeration as `ThreatInputs`, but the feature key
+/// **drops the attacker's from-square**, keeping `(attacker key) x (TARGET square) x (attacked rel)
+/// = 10 x 64 x 12 = 7680` features (~10x smaller than the full 80304). Rationale: the base HalfKA
+/// already encodes every piece's square, so re-encoding the attacker's location inside every threat
+/// feature is redundant. Multiple attackers of the same type onto the same target now collapse to
+/// ONE feature, so map_features DEDUPES. (Engine-side incremental update must therefore count
+/// attackers per (key,target) rather than toggle independent from->to features.)
+#[derive(Clone, Debug, Default)]
+pub struct LeanThreatInputs;
+
+const LEAN_NUM_FEATURES: usize = NUM_ATTACKER_KEYS * 64 * NUM_ATTACKED_REL; // 10*64*12 = 7680
+
+impl LeanThreatInputs {
+    pub fn new() -> Self {
+        Self
+    }
+
+    #[inline]
+    fn lean_index(attacker_key: usize, to_o: usize, attacked_rel: usize) -> usize {
+        (attacker_key * 64 + to_o) * NUM_ATTACKED_REL + attacked_rel
+    }
+}
+
+impl SparseInputType for LeanThreatInputs {
+    type RequiredDataType = ChessBoard;
+
+    fn num_inputs(&self) -> usize {
+        LEAN_NUM_FEATURES
+    }
+
+    fn max_active(&self) -> usize {
+        128 // <= full ThreatInputs edge count (dedup only merges edges), so 128 is a safe cap
+    }
+
+    fn map_features<F: FnMut(usize, usize)>(&self, pos: &Self::RequiredDataType, mut f: F) {
+        let mut occ: u64 = 0;
+        let mut squares: Vec<(usize, usize)> = Vec::with_capacity(32);
+        for (piece, square) in pos.into_iter() {
+            occ |= 1u64 << square;
+            squares.push((usize::from(piece), usize::from(square)));
+        }
+        let piece_at = |sq: usize, sqs: &[(usize, usize)]| -> Option<usize> {
+            sqs.iter().find(|&&(_, s)| s == sq).map(|&(p, _)| p)
+        };
+
+        let our_k = usize::from(pos.our_ksq());
+        let opp_k = usize::from(pos.opp_ksq());
+        let stm_flip = if file(our_k) > 3 { 7 } else { 0 };
+        let ntm_flip = if file(opp_k) > 3 { 7 } else { 0 };
+
+        // collect (stm_idx, ntm_idx) per attack edge, then dedup (from-square dropped => collisions)
+        let mut seen: Vec<(u32, u32)> = Vec::with_capacity(64);
+        for &(piece, from) in &squares {
+            let colour = (piece >> 3) & 1;
+            let pt = piece & 7;
+            if pt == KING {
+                continue; // king is not a threat source (matches ThreatInputs / SF)
+            }
+            let attacks = match pt {
+                PAWN => pawn_attacks(from, colour == 0),
+                KNIGHT => knight_attacks(from),
+                KING => 0,
+                _ => slider_attacks(pt, from, occ),
+            } & occ; // only occupied targets
+
+            let mut bb = attacks;
+            while bb != 0 {
+                let to = bb.trailing_zeros() as usize;
+                bb &= bb - 1;
+                let tpiece = match piece_at(to, &squares) {
+                    Some(p) => p,
+                    None => continue,
+                };
+                let tcolour = (tpiece >> 3) & 1;
+                let tpt = tpiece & 7;
+                // lean index keeps the TARGET square (oriented like HalfKA), drops `from`.
+                let s = Self::lean_index(colour * 5 + pt, to ^ stm_flip, tcolour * 6 + tpt);
+                let n = Self::lean_index((colour ^ 1) * 5 + pt, (to ^ 56) ^ ntm_flip, (tcolour ^ 1) * 6 + tpt);
+                seen.push((s as u32, n as u32));
+            }
+        }
+        seen.sort_unstable();
+        seen.dedup();
+        for (s, n) in seen {
+            f(s as usize, n as usize);
+        }
+    }
+
+    fn shorthand(&self) -> String {
+        format!("leanthreats{LEAN_NUM_FEATURES}")
+    }
+
+    fn description(&self) -> String {
+        "Lean threat inputs (attacker x TARGET-square x attacked, from-square dropped, deduped)".to_string()
+    }
+}
+
+/// zigqueen v6 FULL-THREATS input: the field-converged 60,144-feature
+/// "SFNNv12-style" space per zigqueen docs/V6_THREATS_SPEC.md (spec r2),
+/// bit-exact vs the source-of-truth grader (tools/fullthreats_grader.py).
+///
+/// Differences vs `ThreatInputs` above: attackers PNBRQ only AND victims
+/// exclude kings entirely; subset-redundant combos removed per attacker type
+/// (P->{P,N,R}, N->{P,N,B,R,Q}, B/R->{P,N,B,R}, Q->{P,N,B,R,Q}); index layout
+/// is the zigqueen spec (ak-major, from ascending, target ascending by SQUARE
+/// ORDER within the empty-board attack set, victim class last). Spec r2: no
+/// activation dedup — both directions of mutual same-type pairs activate
+/// (required for the paired stm/ntm emission below).
+const FT60K_NV: [usize; 5] = [3, 5, 4, 4, 5];
+const FT60K_VRANK: [[i8; 6]; 5] = [
+    [0, 1, -1, 2, -1, -1], // P -> {P,N,R}
+    [0, 1, 2, 3, 4, -1],   // N -> {P,N,B,R,Q}
+    [0, 1, 2, 3, -1, -1],  // B -> {P,N,B,R}
+    [0, 1, 2, 3, -1, -1],  // R -> {P,N,B,R}
+    [0, 1, 2, 3, 4, -1],   // Q -> {P,N,B,R,Q}
+];
+pub const FT60K_FEATURES: usize = 60144;
+
+#[derive(Clone, Debug)]
+pub struct FullThreatInputs60k {
+    ak_offset: [u32; 10],
+    pair_base: [[u16; 64]; 10],
+    empty_att: [[u64; 64]; 10],
+}
+
+impl Default for FullThreatInputs60k {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl FullThreatInputs60k {
+    pub fn new() -> Self {
+        let mut ak_offset = [0u32; 10];
+        let mut pair_base = [[0u16; 64]; 10];
+        let mut empty_att = [[0u64; 64]; 10];
+        let mut off = 0u32;
+        for ak in 0..10 {
+            let own = ak < 5;
+            let pt = ak % 5;
+            ak_offset[ak] = off;
+            let mut pairs = 0u32;
+            for f in 0..64 {
+                pair_base[ak][f] = pairs as u16;
+                let att = match pt {
+                    0 => {
+                        if (8..56).contains(&f) {
+                            pawn_attacks(f, own)
+                        } else {
+                            0 // pawns only on ranks 2..7
+                        }
+                    }
+                    1 => knight_attacks(f),
+                    2 => slider_attacks(BISHOP, f, 0),
+                    3 => slider_attacks(ROOK, f, 0),
+                    _ => slider_attacks(QUEEN, f, 0),
+                };
+                empty_att[ak][f] = att;
+                pairs += att.count_ones();
+            }
+            off += pairs * 2 * FT60K_NV[pt] as u32;
+        }
+        assert_eq!(off as usize, FT60K_FEATURES, "spec r2 table arithmetic");
+        assert_eq!(ak_offset[5], 30072, "per-color block size");
+        Self { ak_offset, pair_base, empty_att }
+    }
+
+    #[inline]
+    fn index(&self, ak: usize, f_o: usize, t_o: usize, victim_own: bool, vrank: usize) -> usize {
+        let att = self.empty_att[ak][f_o];
+        debug_assert!(att >> t_o & 1 == 1, "target not in empty-board set");
+        let pairpos = (att & ((1u64 << t_o) - 1)).count_ones() as usize;
+        let nv = FT60K_NV[ak % 5];
+        let v = if victim_own { 0 } else { nv } + vrank;
+        self.ak_offset[ak] as usize + (self.pair_base[ak][f_o] as usize + pairpos) * 2 * nv + v
+    }
+}
+
+impl SparseInputType for FullThreatInputs60k {
+    type RequiredDataType = ChessBoard;
+
+    fn num_inputs(&self) -> usize {
+        FT60K_FEATURES
+    }
+
+    fn max_active(&self) -> usize {
+        128
+    }
+
+    fn map_features<F: FnMut(usize, usize)>(&self, pos: &Self::RequiredDataType, mut f: F) {
+        let mut occ: u64 = 0;
+        let mut squares: Vec<(usize, usize)> = Vec::with_capacity(32);
+        for (piece, square) in pos.into_iter() {
+            occ |= 1u64 << square;
+            squares.push((usize::from(piece), usize::from(square)));
+        }
+        let piece_at = |sq: usize, sqs: &[(usize, usize)]| -> Option<usize> {
+            sqs.iter().find(|&&(_, s)| s == sq).map(|&(p, _)| p)
+        };
+
+        let stm_flip = if file(usize::from(pos.our_ksq())) > 3 { 7 } else { 0 };
+        let ntm_flip = if file(usize::from(pos.opp_ksq())) > 3 { 7 } else { 0 };
+
+        for &(piece, from) in &squares {
+            let colour = (piece >> 3) & 1; // 0 = stm side
+            let pt = piece & 7;
+            if pt == KING {
+                continue; // kings never attackers
+            }
+            let attacks = match pt {
+                PAWN => pawn_attacks(from, colour == 0),
+                KNIGHT => knight_attacks(from),
+                _ => slider_attacks(pt, from, occ),
+            } & occ;
+
+            let mut bb = attacks;
+            while bb != 0 {
+                let to = bb.trailing_zeros() as usize;
+                bb &= bb - 1;
+                let tpiece = match piece_at(to, &squares) {
+                    Some(p) => p,
+                    None => continue,
+                };
+                let tpt = tpiece & 7;
+                if tpt == KING {
+                    continue; // king victims excluded
+                }
+                let vr = FT60K_VRANK[pt][tpt];
+                if vr < 0 {
+                    continue; // subset-redundant combo
+                }
+                let vrank = vr as usize;
+                let tcolour = (tpiece >> 3) & 1;
+
+                let s = self.index(colour * 5 + pt, from ^ stm_flip, to ^ stm_flip, tcolour == 0, vrank);
+                let n = self.index(
+                    (colour ^ 1) * 5 + pt,
+                    (from ^ 56) ^ ntm_flip,
+                    (to ^ 56) ^ ntm_flip,
+                    tcolour == 1,
+                    vrank,
+                );
+                f(s, n);
+            }
+        }
+    }
+
+    fn shorthand(&self) -> String {
+        format!("fullthreats{FT60K_FEATURES}")
+    }
+
+    fn description(&self) -> String {
+        "zigqueen v6 full-threats inputs (60,144, spec r2, no king threats)".to_string()
+    }
+}
+
+// ---- runtime attack bitboards (occupancy-aware) ----
+
+fn knight_attacks(sq: usize) -> u64 {
+    let mut bb = 0u64;
+    for to in max_pattern(KNIGHT, sq) {
+        bb |= 1u64 << to;
+    }
+    bb
+}
+
+fn pawn_attacks(sq: usize, up: bool) -> u64 {
+    let mut bb = 0u64;
+    for to in pawn_pattern(sq, up) {
+        bb |= 1u64 << to;
+    }
+    bb
+}
+
+fn slider_attacks(pt: usize, sq: usize, occ: u64) -> u64 {
+    let r = rank(sq) as i32;
+    let f = file(sq) as i32;
+    let mut dirs: Vec<(i32, i32)> = Vec::new();
+    if pt != ROOK {
+        dirs.extend_from_slice(&[(1, 1), (1, -1), (-1, 1), (-1, -1)]);
+    }
+    if pt != BISHOP {
+        dirs.extend_from_slice(&[(1, 0), (-1, 0), (0, 1), (0, -1)]);
+    }
+    let mut bb = 0u64;
+    for (dr, df) in dirs {
+        let (mut nr, mut nf) = (r + dr, f + df);
+        while (0..8).contains(&nr) && (0..8).contains(&nf) {
+            let to = (nr * 8 + nf) as usize;
+            bb |= 1u64 << to;
+            if occ & (1u64 << to) != 0 {
+                break; // blocked; this (occupied) square is the target, stop the ray
+            }
+            nr += dr;
+            nf += df;
+        }
+    }
+    bb
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn pair_count_is_compact() {
+        let idx = ThreatIndex::new();
+        assert!(idx.num_pairs > 4000 && idx.num_pairs < 9000, "num_pairs = {}", idx.num_pairs);
+        let n = idx.num_features();
+        for key in 0..NUM_ATTACKER_KEYS {
+            for from in 0..64 {
+                for to in 0..64 {
+                    if let Some(i) = idx.index(key, from, to, NUM_ATTACKED_REL - 1) {
+                        assert!(i < n, "idx {} >= {}", i, n);
+                    }
+                }
+            }
+        }
+        eprintln!("threat features = {} ({} pairs x {})", n, idx.num_pairs, NUM_ATTACKED_REL);
+    }
+
+    #[test]
+    fn rook_ray_blocks_on_first_occupant() {
+        let occ = (1u64 << 0) | (1u64 << 16) | (1u64 << 3);
+        let att = slider_attacks(ROOK, 0, occ);
+        assert!(att & (1u64 << 8) != 0, "a2 attacked");
+        assert!(att & (1u64 << 16) != 0, "a3 attacked (first blocker)");
+        assert!(att & (1u64 << 24) == 0, "a4 NOT attacked (behind blocker)");
+        assert!(att & (1u64 << 3) != 0, "d1 attacked along rank");
+    }
+
+    /// zigqueen spec-r2 grader cross-check (tools/fullthreats_grader.py).
+    /// White-to-move FENs: data frame == absolute frame, stm == grader white
+    /// persp, ntm == grader black persp.
+    #[test]
+    fn ft60k_matches_zigqueen_grader_vectors() {
+        let inputs = FullThreatInputs60k::new();
+        let cases: [(&str, &[u16], &[u16]); 3] = [
+            (
